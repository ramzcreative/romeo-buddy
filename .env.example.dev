# The environment Craft is currently running in (dev, staging, production, etc.)
ENVIRONMENT=dev

# The application ID used to to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=

# Database Configuration
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=127.0.0.1
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=
CRAFT_DB_USER=root
CRAFT_DB_PASSWORD=
CRAFT_DB_SCHEMA=
CRAFT_DB_TABLE_PREFIX=craft_

# The URI segment that tells Craft to load the control panel
CRAFT_SECURITY_KEY=
CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true
CRAFT_CP_TRIGGER="admin"

CUSTOM_THEME="default"
CUSTOM_TEMPLATES_PATH="themes/${CUSTOM_THEME}/templates/"
CUSTOM_SRC_PATH="themes/${CUSTOM_THEME}/src/"

#DEV PORTS
# Must be unique across every site you run locally at the same time --
# the Vite dev server binds 0.0.0.0, so two sites sharing a port means
# whichever one grabs it first silently serves its JS/CSS to *both*
# domains (no error, just the wrong site's assets/HMR).
DEV_PORT_HTTP="8092"
DEV_PORT_HTTPS="8093"

PRIMARY_SITE_URL=

DIGITAL_KEY_ID=
DIGITAL_KEY_SECRET=
DIGITAL_CDN=
DIGITAL_ENDPOINT=
DIGITAL_REGION=
DIGITAL_BUCKET=

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

SITE_NAME=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Theme Designer's "Download from the library" section (dev-only tool,
# see craft-modules/docs/theme-library-spec.md) — a fine-grained,
# repo-scoped GitHub PAT for the private ramzcreative/theme-library repo.
# Leave blank to leave that section dormant; nothing else breaks.
THEME_LIBRARY_TOKEN=

# Shows Theme Designer's "Theme library" publish/update section — off by
# default so a client site can never accidentally push its own theme into
# the shared library. Only flip to true on sites meant to publish FROM
# (launch-pad, or a client site with a design worth sharing back). Needs
# THEME_LIBRARY_TOKEN to actually have write access, not just read.
THEME_LIBRARY_PUBLISHING=false

# Boilerplate updates: this site can take stables changes (scripts/boilerplate.sh).
# True on a dev copy while pulling boilerplate work in; see README § Boilerplate updates on this site.
BOILERPLATE_UPDATES=true
