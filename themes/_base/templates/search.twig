{# Internal search results are exactly the kind of thin/duplicate content
   Google's own guidelines say shouldn't be indexed — with no backing entry
   there's no `seo.noindex` field to check, so scaffold.twig's
   renderSeoTags() call needs this explicit flag instead. See
   modules/seo/services/SeoResolver.php's getRobotsContent(). #}
{% set forceNoindex = true %}

{% extends '_layouts' %}

{% import '_utilities/format' as format %}
{% import '_utilities/transforms' as transform %}

{% set query = craft.app.request.getQueryParam('q') %}

{# section('*') resolves to every real section, which also excludes nested
   Matrix block entries — those carry a null sectionId in Craft 5 and were
   leaking in as results with no URL, i.e. cards that could never link
   anywhere. #}
{% set entries = query ? craft.entries.section('*').search(query).with(['image']).all() : false %}

{% block main %}
    <article class="search section relative">
        <div class="container">

            <div class="search-header">
                <h1>Search</h1>

                <form class="search-form form-default" action="{{ url('search/') }}">
                    <input type="search" name="q" aria-label="Search" placeholder="Search">
                    
                    <button type="submit" class="btn">Search</button>
                </form>
            </div>

            {% if entries|length %}
            <div class="card card--search">
                <p class="search-query text-center">Entries related to "{{ query }}"</p>
                
                <div class="card__items">
                    {% for entry in entries %}

                    {% set heading = entry['heading'] ?? entry.title %}
                    {% set image = entry['image'] ?? false %}

                    <div class="card__item relative">
                        {# Overlay for the mouse. This was format.getLinkAria(entry),
                           which resolves entry.buttons.one().linkUrl — a page or blog
                           post has no buttons, so it emitted nothing and the card had
                           no link at all, for any user. #}
                        {{ format.getLinkAria(entry) }}
                        
                        {{ transform.getImage({
                            'asset': image,
                            'transform': 'card',
                            'wrapperClasses': "card__image-wrapper",
                            'classes': "card__image object-fit",
                            'placeholder': true
                        }) }}

                        <div class="card__info">
                            {# The real, focusable link. format.simple() rather than
                               basic() because basic()'s allowlist permits a[href], and
                               editor markup would nest an anchor inside this one. The
                               `link` class carries z-index 4, which lifts it clear of
                               the .ada-link overlay at 3. #}
                            <p class="card__heading">
                                {% if entry.url %}
                                <a class="link" href="{{ entry.url }}">{{ format.simple(heading) }}</a>
                                {% else %}
                                {{ format.basic(heading) }}
                                {% endif %}
                            </p>
                        </div>
                        
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% else %}
                {% if query %}
                <p>Your search for <span class="bold">“{{ query }}”</span> didn’t return any results.</p>
                {% endif %}
            {% endif %}
        </div>
    </article>

{% endblock %}
