{% extends "_layouts" %}

{# globals #}

{% import '_utilities/transforms' as transform %}
{% import '_utilities/format' as format %}

{% set topicsQuery = entry['topics'] ?? null %}
{% set topics = topicsQuery ? topicsQuery.all() : [] %}
{% set title = entry.heading ?? entry.title %}
{% set intro = entry['intro'] ?? entry['excerpt'] ?? false %}
{% set blocks = entry.postBuilder.all() ?? null %}

{# back link: links back to the previous page if there's user history otherwise links to the main blog page. This is a global setting (site->blog back link).#}
{% set backHistory = craft.app.request.referrer ?? false %}
{% set backUrl = backHistory ? backHistory :  (general['blogBackLink'] ? true : false) and general.blogBackLink ? general.blogBackLink.value : false %}

{% block main %}
<div class="blog-detail blog-container">

    
    {% include '_sections/blog/heroDetail' %}

    {# detail content #}
    <div class="blog-detail__container section">
        <div class="blog-detail__row layout-content">
            {# column #}
            <div class="blog-detail__column blog-detail__column--main">

                {# Back link, title and date live in the hero band above. #}
                {% if intro %}
                <div class="blog-detail__intro">
                    <p class="faux-p-lg">{{ format.basic(intro) }}</p>
                </div>
                {% endif %}

                {% for block in blocks %}
                    {% include '_blocks/' ~ block.type.handle with {entry: block, index: loop.index } only %}
                {% endfor %}
            </div>

            {# column #}
            {% if topics|length %}
            <div class="blog-detail__column blog-detail__column--side">
                <div class="blog-detail__cats">
                    <p id="blog-detail-topics" class="blog-detail__cats-heading uppercase faux-h5">{{ 'Topics'|t }}:</p>
                    <ul role="list" class="blog-detail__cats-items ignore" aria-labelledby="blog-detail-topics">
                        {% for topic in topics %}
                        <li><a href="{{ topic.url }}" class="blog-detail__cats-item">{{ topic.title }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            {% endif %}
        </div>
    </div>

    {% cache using key themeCacheKey('related-' ~ entry.id) unless currentUser %}
        {% include '_partials/related' with { items: relatedEntries(entry) } only %}
    {% endcache %}

</div>
{% endblock %}