{% import '_utilities/nav' as nav %}

{# Reuse the listing's own categories when it passes them in — index.twig has
   already queried exactly this list, so fetching it again is pure waste. Still
   queries for itself if included from anywhere that doesn't pass them. #}
{% set categories = categories ?? craft.categories().group('blogCategory').orderBy('lft ASC').collect() %}
{% set currCatId = category is defined ? category.id : -1 %}

{% if categories|length > 0 %}
<div class="blog-nav section relative">
    <div class="blog-nav__int wrapper">

        <span class="blog-nav__label uppercase ">Categories:</span>

        <div class="blog-nav__wrapper relative overflow-hidden">
            <div class="scroller-nav-container">
                <scroll-nav class="blog-nav__items ignore">
                    {{ nav.standard(categories)}}
                </scroll-nav>
            </div>
        </div>
        
    </div>
</div>
{% endif %}