{% extends "_layouts" %}

{% import '_utilities/format' as format %}
{% import '_utilities/transforms' as transform %}
{% import '_utilities/events' as events %}


{% set title = entry.heading ?? entry.title %}
{% set image = entry.image.collect().first() ?? false %}
{% set status = events.status(entry)|trim %}
{% set isOnline = entry.eventIsOnline ?? false %}
{% set price = entry.eventPrice %}
{% set hasPrice = price is not null and price != '' %}
{% set venue = entry.eventLocationName ?? false %}
{% set address = entry.eventAddress ?? false %}
{% set registerUrl = entry.eventUrl ?? false %}

{# Back to the listing this came from where possible, so a visitor keeps their
   filters. Falls back to the events index. #}
{% set referrer = craft.app.request.referrer ?? false %}
{% set eventsIndex = craft.entries().section('pages').slug('events').one() ?? false %}
{% set backUrl = referrer ?: (eventsIndex ? eventsIndex.url : false) %}

{#
    Rendered into the layout's contentHeader block rather than overriding main.
    _layouts/index.twig's own content block dispatches page-builder blocks
    through _blocks/_builder, which normalizes Matrix vs CKEditor shapes and
    passes each block as `entry` — the variable every block template reads.
    Hand-rolling that loop here passed `chunk` instead and broke any block
    expecting `entry` (entryHeading reads entry.owner, so it threw outright).
#}
{% block contentHeader %}
<article class="event-detail">

    <header class="event-detail__hero">
        <div class="layout-content event-detail__hero-int">

            {% if backUrl %}
                <a href="{{ backUrl }}" class="event-detail__back btn btn--arrow-reverse btn--text">{{ 'Back to events'|t }}</a>
            {% endif %}

            <div class="event-detail__hero-grid">

                <div class="event-detail__hero-main">

                    {% if status == 'running' %}
                        {# The dot is decorative — the label already says it in words,
                           so colour is never the only signal (WCAG 1.4.1). #}
                        <p class="event-detail__status event-detail__status--running ignore">
                            <span class="event-detail__status-dot" aria-hidden="true"></span>{{ 'Happening now'|t }}
                        </p>
                    {% elseif status == 'past' %}
                        {# Derived from the date, so nobody has to remember to edit or
                           unpublish the page once it's over — the URL stays alive for
                           anyone arriving from an old link or a shared post. #}
                        <p class="event-detail__status event-detail__status--past ignore">
                            {{ 'This event has finished. Dates for the next one will be posted here.'|t }}
                        </p>
                    {% endif %}

                    {# `.ignore` is load-bearing — see events.pcss's note on this heading. #}
                    <h1 class="event-detail__heading ignore">{{ format.basic(title) }}</h1>

                    {% if entry.excerpt %}
                        <p class="event-detail__intro">{{ format.basic(entry.excerpt) }}</p>
                    {% endif %}
                </div>

                {# The practical block, together and ahead of the description: what a
                   visitor came for is when, where, how much and how to book. #}
                <div class="event-detail__panel">

                    <div class="event-detail__panel-head">
                        {{ events.badge(entry) }}
                        {# The badge is aria-hidden, so this line carries the date for
                           anyone not looking at it. #}
                        <p class="event-detail__panel-when ignore">{{ events.range(entry, true) }}</p>

                        {% set repeats = eventRuleSentence(entry) %}
                        {% if repeats %}
                            <p class="event-detail__panel-repeat ignore">{{ repeats }}</p>
                        {% endif %}
                    </div>

                    {# Every date it happens on, not just the next: someone deciding which Saturday to come needs
                       the list. The first eight are open, the rest are behind a native <details> — no JavaScript,
                       and it works in a printed page. A cancelled date stays in the list, said out loud, because
                       silence is what sends someone to a market that isn't on. #}
                    {% if repeats %}
                        {# Asked for one more than the ceiling, so the page can tell "all of them" from "the next
                           60" without a second query. A daily event runs to ~550 rows inside the horizon, and
                           nobody reads 550 dates — the rule sentence above already says it keeps going. #}
                        {% set dateLimit = 60 %}
                        {% set dates = eventDates(entry, 'upcoming', dateLimit + 1) %}
                        {% set capped = dates|length > dateLimit %}
                        {% set dates = capped ? dates|slice(0, dateLimit) : dates %}

                        {% if dates|length > 1 %}
                            {% set shown = dates|slice(0, 8) %}
                            {% set rest = dates|slice(8) %}

                            <div class="event-detail__dates">
                                <h2 class="event-detail__dates-title faux-h5">{{ 'Upcoming dates'|t }}</h2>

                                {{ _self.dateList(shown) }}

                                {% if rest|length %}
                                    <details class="event-detail__dates-more">
                                        <summary>
                                            {{ capped
                                                ? 'Show the next {n} dates'|t({ n: dates|length })
                                                : 'Show all {n} dates'|t({ n: dates|length }) }}
                                        </summary>
                                        {{ _self.dateList(rest) }}
                                    </details>
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endif %}

                    <dl class="event-detail__facts">
                        {% if isOnline %}
                            <div class="event-detail__fact">
                                <dt>{{ 'Where'|t }}</dt>
                                <dd>{{ 'Online'|t }}</dd>
                            </div>
                        {% elseif venue or address %}
                            <div class="event-detail__fact">
                                <dt>{{ 'Where'|t }}</dt>
                                <dd>
                                    {% if venue %}<span class="event-detail__venue">{{ format.plain(venue) }}</span>{% endif %}
                                    {% if address %}
                                        <span class="event-detail__address">{{ format.plain(address) }}</span>
                                        {# rel=noopener on a cross-origin target: without it the opened
                                           page gets a window.opener handle back to this one. #}
                                        <a class="event-detail__map link"
                                           href="https://www.google.com/maps/search/?api=1&query={{ (venue ~ ' ' ~ address)|trim|url_encode }}"
                                           target="_blank" rel="noopener noreferrer">{{ 'View on map'|t }}<span class="visually-hidden">{{ '(opens in a new tab)'|t }}</span></a>
                                    {% endif %}
                                </dd>
                            </div>
                        {% endif %}

                        {% if hasPrice %}
                            <div class="event-detail__fact">
                                <dt>{{ 'Price'|t }}</dt>
                                <dd class="event-detail__price">{{ events.price(price) }}</dd>
                            </div>
                        {% endif %}
                    </dl>

                    {% if status != 'past' %}
                        <div class="event-detail__cta">
                            {% if registerUrl %}
                                <a class="btn event-detail__register" href="{{ registerUrl }}" target="_blank" rel="noopener noreferrer">
                                    {{ 'Register'|t }}
                                    <span class="visually-hidden">{{ '(opens in a new tab)'|t }}</span>
                                </a>
                            {% endif %}

                            {# Served by the seo module (see IcsController). Keyed on
                               id rather than slug because the section's URL is
                               per-client. Hidden once an event is past — adding a
                               finished event to a calendar helps nobody. #}
                            <a class="btn btn--text event-detail__ics"
                               href="{{ url('calendar/' ~ entry.id ~ '.ics') }}"
                               download>
                                {{ 'Add to calendar'|t }}
                                <span class="visually-hidden">{{ '(downloads an .ics file)'|t }}</span>
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </header>

    {% if image %}
        <div class="layout-content event-detail__hero-media">
            {{ transform.getImage({
                'asset': image,
                'transform': 'video',
                'to-md': 'card',
                'wrapperClasses': 'event-detail__hero-image-wrapper overflow-hidden',
                'classes': 'event-detail__hero-image object-fit'
            }) }}
        </div>
    {% endif %}

</article>
{% endblock %}

{% block contentFooter %}
{# Today is in the key: an event card shows its next date, which changes with the clock, not with a save. #}
{% set today = now|date('Y-m-d') %}
{% cache using key themeCacheKey('related-' ~ entry.id ~ '-' ~ today) unless currentUser %}
    {% include '_partials/related' with { items: relatedEntries(entry) } only %}
{% endcache %}
{% endblock %}

{# One list of dates. A cancelled one keeps its place and says so, rather than disappearing. #}
{% macro dateList(dates) %}
    <ul role="list" class="event-detail__dates-list">
        {% for date in dates %}
            <li class="event-detail__date{{ date.cancelled ? ' event-detail__date--cancelled' }}">
                <time datetime="{{ date.start|date('c') }}">
                    {{- date.start|date('D j M Y') }}{% if not date.allDay %} {{ date.start|date('g:ia') }}{% endif -%}
                </time>
                {% if date.cancelled %}<span class="event-detail__date-note">{{ 'Cancelled'|t }}</span>{% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}
