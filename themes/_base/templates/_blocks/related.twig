{# The editor's picks; with too few, topped up from the page's topics. Renders nothing when empty. #}
{# Today is in the key because an event card shows its NEXT date, which changes with the clock rather than
   with a save — the same reason the events listing carries it. #}
{% set today = now|date('Y-m-d') %}
{% cache using key themeCacheKey('related-block-' ~ entry.id ~ '-' ~ today) unless currentUser %}
    {% include '_partials/related' with {
        items: relatedForBlock(entry),
        block: entry,
    } only %}
{% endcache %}
