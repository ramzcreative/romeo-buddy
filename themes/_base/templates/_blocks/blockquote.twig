
<blockquote {{ inlineEditBlock(entry) }}>
    <header>
        <p {{ inlineEditAttrs(entry, 'textPlain') }}>{{entry.textPlain}}</p>
    </header>

    {% if entry['citeName']|default or entry['citeTitle']|default %}
    <footer>
        <span {{ inlineEditAttrs(entry, 'citeName') }}>{{ entry['citeName']|default }}</span>

        {% if entry['citeTitle'] %}
        <cite title="Title, Company" {{ inlineEditAttrs(entry, 'citeTitle') }}>{{entry.citeTitle}}</cite>
        {% endif %}
    </footer>
    {% endif %}
</blockquote>