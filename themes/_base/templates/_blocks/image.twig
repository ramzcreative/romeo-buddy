{% import '_blocks/partials/background' as background %}
{% import '_utilities/format' as format %}
{% import '_utilities/transforms' as transform %}

{% set owner = entry['owner'] ?? false %}
{% set type = owner ? owner.type : 'page' %}

{% set image = entry.image.one() ?? false %}
{% set transformKey = entry['fullwidth']|default(false) ? 'fullwidth' : 'fluid' %}

{# No image, no block: nothing on it is required (see docs/theme-designer-blocks-spec.md §3). #}
{% if image %}
<article class="image-block section {{ type == 'container' ? 'section--sm' }} relative {{ background.classes(entry) }}" {{ inlineEditBlock(entry) }}>
	{{ background.image(entry, preloadImage ?? false) }}

	{# heading block #}
	{% include '_blocks/partials/heading' %}

	<div class="image-block__int container">

		{{ transform.getImage({
			'asset': image,
			'transform': transformKey,
			'to-lg': 'fluid',
			'wrapperClasses': 'image__wrapper media-overlay media-wrapper',
			'classes': '',
			'placeholder': true,
			'preload': preloadImage ?? false
		}) }}
	</div>
</article>
{% endif %}
