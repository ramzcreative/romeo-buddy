{% import '_utilities/format' as format %}
{% import '_utilities/transforms' as transform %}

{% set isLast = last ?? false %}
{% set layout = entry['layoutCards'] ?? 'grid' %}    
{# Primed before the loop, not resolved per card: an item can pull its
   content from a selected entry, and without this each card would query for
   that entry and again for its image. itemEagerLoadPaths() is built from
   config/stables/items.php, so it can't fall out of step with what gets resolved. #}
{% set items = entry.items.with(itemEagerLoadPaths()).all() ?? false %}

{% if items %}
	{# `only`, matching slider.twig — an include that inherits the whole parent
	   context makes it invisible which variables a layout actually depends on,
	   and the two blocks behaving differently is worse than either choice.
	   `entry` is passed explicitly BECAUSE of that: partials/heading reads
	   `entry['blockHeading']`, so without it the Block Heading field saves
	   fine in the CP and silently renders nothing. #}
	{% include "_blocks/layouts/cards/#{layout}" with{
		entry: entry,
		items: items,
		uid: entry.uid,
		preloadImage: preloadImage ?? false
	} only %}
{% endif %}