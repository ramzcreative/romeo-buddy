{% import '_utilities/transforms' as transform %}

{# Resolved rather than read straight off the block, so a hero can pull its
   content from a selected entry — the same chain cards, slider, banner and
   imageText items already use. Anything set on the hero itself still wins field
   by field; see config/stables/items.php for which entry fields feed which key.

   itemData() is generic: it reads `sourceField` from that config and the block
   just needs the matching fields on its layout, which m260822_170000 added. #}
{% set data = itemData(entry) %}
{% set image = data.image ?? false %}

{% set parallax = image and (entry.heroParallax ?? false) %}
{% set heroId = 'hero-' ~ entry.id %}

{% set heroImage %}
		{{ transform.getImage({
			'asset': image,
			'alt': '',
			'transform': 'hero',
			'to-lg': 'heroLg',
			'to-sm': 'heroSm',
			'wrapperClasses': "hero-standard__image-wrapper",
			'classes': "hero-standard__image object-fit",
			'placeholder': true,
			'preload': preloadImage ?? false
		}) }}
{% endset %}

<article id="{{ heroId }}" class="hero-standard hero-standard--full section section--has-bg relative {{ parallax ? 'overflow-clip' }}" data-hero {{ inlineEditBlock(entry) }}>
	<div class="hero-standard__int layout-content">

		{% if parallax %}
		{# Drifts down 30% of its height while the hero scrolls away, so the edge it opens is already off screen.
		   BaseScroll leaves it still under reduced motion. #}
		<div class="hero-standard__media" data-motion="{{ {
			transition: 'scroll',
			targetId: heroId,
			offset: ['start start', 'end start'],
			translateOffset: ['0%', '30%'],
			opacity: [1, 1],
			ease: 'linear'
		}|json_encode }}">
			{{ heroImage }}
		</div>
		{% else %}
		{{ heroImage }}
		{% endif %}

		<div class="hero-standard__info bg--secondary">
			<div class="hero-standard__info-int">
				{% include '_blocks/partials/heroCopy' with { entry: entry, data: data, name: 'hero-standard' } only %}
			</div>
		</div>
	</div>
</article>
