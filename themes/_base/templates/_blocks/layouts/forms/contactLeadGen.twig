{% set uid = entry.uid ?? random() %}

{#
	Webhook routing is entirely server-side/CP-configured (craftcms/webhooks
	plugin — Settings → Webhooks, Sender Class craft\contactform\Mailer,
	Event EVENT_AFTER_SEND) so there's no client-side integration code
	needed here. The message[formName] hidden field below is what lets a
	webhook's payload template (or a Control Panel submissions filter)
	single out lead-gen submissions specifically, e.g. only forwarding
	{{ '{% if event.submission.message.formName == "contactLeadGen" %}' }}
	entries to a buyer's endpoint.
#}

<form class="form form--contact-lead-gen" method="POST" accept-charset="UTF-8" data-contact-form>
	{{ csrfInput() }}
	{{ actionInput('contact-form/send') }}
	<input type="hidden" name="message[formName]" value="contactLeadGen">
	<input type="hidden" name="recaptchaToken" value="">
	{% include '_blocks/partials/honeypot' %}

	<div class="form__fields">
		<div class="form__field">
			<label class="form__label" for="{{ uid }}-firstName">First Name <span class="form__required">*</span></label>
			<input class="form__input" type="text" id="{{ uid }}-firstName" name="message[firstName]" autocomplete="given-name" required>
		</div>

		<div class="form__field">
			<label class="form__label" for="{{ uid }}-lastName">Last Name <span class="form__required">*</span></label>
			<input class="form__input" type="text" id="{{ uid }}-lastName" name="message[lastName]" autocomplete="family-name" required>
		</div>

		<div class="form__field">
			<label class="form__label" for="{{ uid }}-fromEmail">Email <span class="form__required">*</span></label>
			<input class="form__input" type="email" id="{{ uid }}-fromEmail" name="fromEmail" autocomplete="email" required>
		</div>

		<div class="form__field">
			<label class="form__label" for="{{ uid }}-phone">Phone</label>
			<input class="form__input" type="tel" id="{{ uid }}-phone" name="message[phone]" autocomplete="tel">
		</div>

		<div class="form__field form__field--full">
			<label class="form__label" for="{{ uid }}-message">Message</label>
			<textarea class="form__textarea" id="{{ uid }}-message" name="message[body]"></textarea>
		</div>

		{#
			Required — this is a distinct legal requirement from the
			honeypot/recaptcha spam checks above: submitting this data
			hands it to a third-party partner/buyer (see the webhook note
			at the top of this file), which a visitor wouldn't reasonably
			expect just from filling in "get a quote." Don't remove
			`required` without updating the site's privacy policy to
			match — see stables' "Privacy Policy — Lead Gen" reference
			entry for the disclosure this checkbox depends on.
		#}
		<div class="form__field form__field--checkbox form__field--full">
			<input class="form__checkbox" type="checkbox" id="{{ uid }}-shareConsent" name="message[shareConsent]" value="1" required>
			<label class="form__checkbox-label" for="{{ uid }}-shareConsent">I agree to have my information shared with the relevant partner so they can respond to my request. <span class="form__required">*</span></label>
		</div>
	</div>

	<div class="form__actions">
		<button type="submit" class="btn form__submit">Submit</button>
		<noscript><p class="form__notice">JavaScript is required to submit this form.</p></noscript>
	</div>

	{# Live region. Without a role here contactForm.ts can write text into this
	   div and flip `hidden`, and a screen reader is told nothing at all — the
	   message is purely visual. role="status" is polite by default; the JS
	   upgrades it to role="alert" on failure so an error interrupts.
	   aria-atomic so the whole message is re-read, not just the changed words. #}
	<div class="form__message" data-form-message role="status" aria-live="polite" aria-atomic="true" hidden></div>
</form>
