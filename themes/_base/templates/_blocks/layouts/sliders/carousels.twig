{% import '_utilities/format' as format %}
{% import '_utilities/transforms' as transform %}

{# Looping is off by default — this layout reads as a shelf you reach the end
   of — but it is a one-line switch, and the effect handles both. #}
{% set carouselLoop = false %}

{# Loop mode needs enough slides to fill the row and still have some in hand;
   short sliders repeat up to minSlides then trim to exactly that. The old
   `7 - total` was a pass count, and passes multiply. Only ever with the loop
   on: without it the repeats sit on screen beside each other. #}
{% set total = items|length %}
{% set minSlides = 9 %}
{% set slides = items %}

{% if carouselLoop and total and total < minSlides %}
	{% for i in 1..((minSlides / total)|round(0, 'ceil') - 1) %}
		{% set slides = slides|merge(items) %}
	{% endfor %}
	{% set slides = slides|slice(0, minSlides) %}
{% endif %}

{# data-slider-block: the arrows sit outside the <swiper-container> so they can
   line up with the content container, and Helpers/sliders.js scopes its lookup
   to this element to find them. #}
<article class="slider-carousel section px-0 relative" data-slider-block>

	{% include '_blocks/partials/heading' %}

	{# Full width on purpose, and clipped by the block: a card leaving to the
	   left should run off the screen edge rather than stop at the container's.
	   The row is brought back in line with the container by the effect, which
	   measures [data-slider-gutter] below and hands Swiper the offset. #}
	<swiper-container class="slider-carousel__wrapper"
		init="false"
		speed="900"
		grab-cursor="true"
		slides-per-view="auto"
		loop="{{ carouselLoop ? 'true' : 'false' }}"
		loop-additional-slides="2"
		effect="ramz-carousel"
	>
		{% for item in slides %}
			{# Resolved rather than read straight off the item: it can pull its
			   content from a selected entry, with anything set on the item itself
			   winning field by field. See config/stables/items.php. #}
			{% set data = itemData(item) %}
			{% set preheading = data.preheading ?? false %}
			{% set heading = data.heading ?? false %}
			{% set intro = data.intro ?? false %}
			{% set image = data.image ?? false %}

			<swiper-slide class="slider-carousel__slide">
				<div class="slider-carousel__card">

					{{ format.getLinkAria(item) }}

					{% if image %}
						{{ transform.getImage({
							'asset': image,
							'alt': '',
							'transform': 'card',
							'wrapperClasses': 'slider-carousel__image-wrapper',
							'classes': 'slider-carousel__image object-fit',
							'placeholder': true,
							'preload': loop.first and (preloadImage ?? false)
						}) }}
					{% endif %}

					<div class="slider-carousel__veil"></div>

					<div class="slider-carousel__copy">
						{% if preheading %}
							<p class="slider-carousel__preheading faux-preheading">{{ format.basic(preheading) }}</p>
						{% endif %}

						{% if heading %}
							<p class="slider-carousel__heading faux-h3">{{ format.basic(heading) }}</p>
						{% endif %}

						{% if intro %}
							{{ intro|retconAttr('p', { class: 'slider-carousel__intro' }) }}
						{% endif %}

						{% include '_blocks/buttons' with { entry: item, options: {classes:'btn btn--arrow slider-carousel__btn'} } only %}
					</div>

				</div>
			</swiper-slide>
		{% endfor %}

	</swiper-container>

	{# data-slider-gutter: this is the container edge the row lines up with. #}
	<div class="slider-carousel__actions container" data-slider-gutter>
		<button type="button" class="slider-carousel__arrow swiper-btn-prev" aria-label="{{ 'Previous slide'|t }}">
			{{ svg('@webroot/assets/graphics/arrow-left.svg')|attr({ 'aria-hidden': 'true', focusable: 'false' }) }}
		</button>
		<button type="button" class="slider-carousel__arrow swiper-btn-next" aria-label="{{ 'Next slide'|t }}">
			{{ svg('@webroot/assets/graphics/arrow-right.svg')|attr({ 'aria-hidden': 'true', focusable: 'false' }) }}
		</button>
	</div>

</article>
