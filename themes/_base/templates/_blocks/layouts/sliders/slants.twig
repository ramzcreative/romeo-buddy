{#
    Slant slider.

    Same shape as _blocks/layouts/sliders/sliders.twig — a <swiper-container>
    initialised by js/Helpers/sliders.js — so there is one slider mechanism to
    maintain, not two. All that differs is effect="slant".

    The panel geometry is in js/SliderEffects/effect-slant.esm.js and
    css/blocks/sliderSlants.pcss; this file only supplies the markup contract
    those two expect:

      .slider-slants__slide   the box the effect positions and sizes
      .slider-slants__panel   the clipped parallelogram
      .slider-slants__media   the image, counter-moved as the panel opens
      .slider-slants__info    the copy, revealed on the active panel only
#}

{% import '_utilities/format' as format %}
{% import '_utilities/transforms' as transform %}

{% set items = items ?? false %}
{% set uid = uid ?? 'slant' %}

{% if items %}
<article class="slider-slants relative">

	{% include '_blocks/partials/heading' ignore missing %}

	<div class="slider-slants__int">

		<swiper-container class="slider-slants__container"
			init="false"
			effect="slant"
			speed="900"
			grab-cursor="true"
			loop="true"
			keyboard="true"
			a11y-slide-role="group"
		>

			{% for item in items %}
				{% set data = itemData(item) %}
				{% set heading = data.heading ?? false %}
				{% set preheading = data.preheading ?? false %}
				{% set intro = data.intro ?? false %}
				{% set image = data.image ?? false %}

				<swiper-slide class="slider-slants__slide">
					<div class="slider-slants__panel">

						{# Mouse affordance only — aria-hidden, tabindex -1. The
						   real link is the button in __info below, which is why
						   that block must stay rendered. #}
						{{ format.getLinkAria(item) }}

						{% if image %}
						<div class="slider-slants__media">
							{{ transform.getImage({
								'asset': image,
								'alt': '',
								'transform': 'hero',
								'wrapperClasses': "slider-slants__image-wrapper",
								'classes': "slider-slants__image",
								'placeholder': true,
								'preload': loop.first and (preloadImage ?? false)
							}) }}
						</div>
						{% endif %}

						<div class="slider-slants__info">
							{% if preheading %}
							<p class="slider-slants__preheading faux-preheading">{{ format.basic(preheading) }}</p>
							{% endif %}

							{% if heading %}
							<p class="slider-slants__heading faux-h3">{{ format.basic(heading) }}</p>
							{% endif %}

							{{ intro|retconAttr('p', { class: 'slider-slants__intro' }) }}

							{% include '_blocks/buttons' with { entry: item, options: {
								classes: 'btn btn--arrow slider-slants__btn link'
							} } only %}
						</div>

					</div>
				</swiper-slide>
			{% endfor %}

			<div slot="container-end">
				<div class="swiper-actions">
					<div class="swiper-nav-container">
						<button type="button" class="swiper-btn-prev" aria-label="{{ 'Previous slide'|t }}">
							{{ svg("@webroot/assets/graphics/arrow-left.svg")|attr({
								class: 'swiper-btn-icon',
							}) }}
						</button>
						<button type="button" class="swiper-btn-next" aria-label="{{ 'Next slide'|t }}">
							{{ svg("@webroot/assets/graphics/arrow-right.svg")|attr({
								class: 'swiper-btn-icon',
							}) }}
						</button>
					</div>
				</div>
			</div>

		</swiper-container>

	</div>
</article>
{% endif %}
