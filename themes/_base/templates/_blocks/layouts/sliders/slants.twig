{#
    Slant slider.

    The Material effect with skewed panels. Same <swiper-container> +
    Helpers/sliders.js setup as every other slider here, so there is one slider
    mechanism to maintain; the slant is entirely css/blocks/sliderSlants.pcss.

    Markup below is Material's own contract — .swiper-material-wrapper wrapping
    .swiper-material-content — so the effect works untouched.

    Params match the vendor demo: an INTEGER slidesPerView (Material has a
    separate branch for fractional values with centeredSlides, and at 1.35 every
    panel came out the same width), no gap, 600ms.
#}

{% import '_utilities/format' as format %}
{% import '_utilities/transforms' as transform %}

{% set items = items ?? false %}

{% if items %}
{# Loop needs roughly slidesPerView*3 slides to rotate; below that Swiper pins
   to the last slide and Next silently stops while Prev keeps working. Rewind is
   the honest fallback — and centring only makes sense when looping, since
   without it the first slide parks in the middle with nothing to its left. #}
{% set canLoop = items|length >= 6 %}

<article class="slider-slants relative">

	{% include '_blocks/partials/heading' ignore missing %}

	<div class="slider-slants__int">

		<swiper-container class="slider-slants__container"
			init="false"
			effect="material"
			speed="600"
			grab-cursor="true"
			slides-per-view="2"
			space-between="0"
			keyboard="true"
			loop="{{ canLoop ? 'true' : 'false' }}"
			rewind="{{ canLoop ? 'false' : 'true' }}"
			centered-slides="{{ canLoop ? 'true' : 'false' }}"
		>

			{% for item in items %}
				{% set data = itemData(item) %}
				{% set heading = data.heading ?? false %}
				{% set preheading = data.preheading ?? false %}
				{% set intro = data.intro ?? false %}
				{% set image = data.image ?? false %}

				<swiper-slide class="slider-slants__slide swiper-slide">
					<div class="slider-slants__wrapper swiper-material-wrapper">
						<div class="slider-slants__content swiper-material-content">

							{# Mouse affordance only — aria-hidden, tabindex -1. The real
							   link is the button in __info, which is why that block has
							   to stay rendered. #}
							{{ format.getLinkAria(item) }}

							{% if image %}
							<div class="slider-slants__media">
								{{ transform.getImage({
									'asset': image,
									'alt': '',
									'transform': 'hero',
									'wrapperClasses': "slider-slants__image-wrapper",
									'classes': "slider-slants__image",
									'placeholder': true,
									'preload': loop.first and (preloadImage ?? false)
								}) }}
							</div>
							{% endif %}

							<div class="slider-slants__info swiper-material-animate-opacity">
								{% if preheading %}
								<p class="slider-slants__preheading faux-preheading">{{ format.basic(preheading) }}</p>
								{% endif %}

								{% if heading %}
								<p class="slider-slants__heading faux-h3">{{ format.basic(heading) }}</p>
								{% endif %}

								{{ intro|retconAttr('p', { class: 'slider-slants__intro' }) }}

								{% include '_blocks/buttons' with { entry: item, options: {
									classes: 'btn btn--arrow slider-slants__btn link'
								} } only %}
							</div>

						</div>
					</div>
				</swiper-slide>
			{% endfor %}

			<div slot="container-end">
				<div class="swiper-actions">
					<div class="swiper-nav-container">
						<button type="button" class="swiper-btn-prev" aria-label="{{ 'Previous slide'|t }}">
							{{ svg("@webroot/assets/graphics/arrow-left.svg")|attr({ class: 'swiper-btn-icon' }) }}
						</button>
						<button type="button" class="swiper-btn-next" aria-label="{{ 'Next slide'|t }}">
							{{ svg("@webroot/assets/graphics/arrow-right.svg")|attr({ class: 'swiper-btn-icon' }) }}
						</button>
					</div>
				</div>
			</div>

		</swiper-container>

	</div>
</article>
{% endif %}
