{#
    Slant slider.

    This is the Material effect with an angled edge — not a separate slider
    mechanism. The smooth widening as a slide becomes active is Material's own
    (see js/SliderEffects/effect-material.esm.js, UI Initiative), so there is
    one effect to maintain and one licence to track rather than a hand-rolled
    reimplementation of the same behaviour.

    The slant itself is purely CSS: a clip-path parallelogram on
    .swiper-material-wrapper, scoped under .slider-slants so the other Material
    slider (layouts/sliders/hero.twig) is untouched. Deliberately NOT skew —
    skew needs a counter-skew on the image, the two cancel about different
    origins, and the residual drifts as the width animates, opening a gap in a
    top corner at narrow viewports. A clip path has nothing to cancel.

    centered-slides is what gives the neighbours either side of the active one.

    Markup below is Material's contract: .swiper-material-wrapper wrapping
    .swiper-material-content, with [data-swiper-material-scale] on the image
    container so the photo eases as the panel opens.
#}

{% import '_utilities/format' as format %}
{% import '_utilities/transforms' as transform %}

{% set items = items ?? false %}

{% if items %}
<article class="slider-slants relative">

	{% include '_blocks/partials/heading' ignore missing %}

	<div class="slider-slants__int">

		<swiper-container class="slider-slants__container swiper-wrapper"
			init="false"
			effect="material"
			speed="600"
			grab-cursor="true"
			{# Integer, per the vendor demo. Material has a separate branch for
			   fractional slidesPerView with centeredSlides, and at 1.35 it gave
			   every panel an identical width — nothing expanded. #}
			slides-per-view="2"
			space-between="16"
			centered-slides="true"
			{# Loop only when there are enough slides to rotate. Swiper 11+ loop
			   mode needs roughly slidesPerView*3 — at spv 2 it asks for 3 looped
			   slides, so a block with 4 items pins to isEnd and Next silently
			   stops working while Prev keeps going. Falling back to a non-looping
			   slider is far better than a dead button an editor cannot explain.

			   No loop-prevents-sliding either: it blocks slideNext/slidePrev
			   outright while slideTo keeps working, which reads as miswired
			   buttons rather than a locked slider. #}
			loop="{{ items|length >= 6 ? 'true' : 'false' }}"
			rewind="{{ items|length >= 6 ? 'false' : 'true' }}"
			{# No loop-prevents-sliding: it blocks slideNext/slidePrev outright here
			   (slideTo still works, which is what makes it look like the buttons are
			   wired wrong rather than the slider being locked). #}
			keyboard="true"
		>

			{% for item in items %}
				{% set data = itemData(item) %}
				{% set heading = data.heading ?? false %}
				{% set preheading = data.preheading ?? false %}
				{% set intro = data.intro ?? false %}
				{% set image = data.image ?? false %}

				<swiper-slide class="slider-slants__slide swiper-slide">
					<div class="slider-slants__wrapper swiper-material-wrapper">
						<div class="slider-slants__content swiper-material-content">

							{# Mouse affordance only — aria-hidden, tabindex -1. The
							   real link is the button in __info, which is why that
							   block must stay rendered. #}
							{{ format.getLinkAria(item) }}

							{% if image %}
							<div class="slider-slants__media">
								{{ transform.getImage({
									'asset': image,
									'alt': '',
									'transform': 'hero',
									'wrapperClasses': "slider-slants__image-wrapper",
									'classes': "slider-slants__image object-fit",
									'placeholder': true,
									'preload': loop.first and (preloadImage ?? false)
								}) }}
							</div>
							{% endif %}

							<div class="slider-slants__info swiper-material-animate-opacity">
								{% if preheading %}
								<p class="slider-slants__preheading faux-preheading">{{ format.basic(preheading) }}</p>
								{% endif %}

								{% if heading %}
								<p class="slider-slants__heading faux-h3">{{ format.basic(heading) }}</p>
								{% endif %}

								{{ intro|retconAttr('p', { class: 'slider-slants__intro' }) }}

								{% include '_blocks/buttons' with { entry: item, options: {
									classes: 'btn btn--arrow slider-slants__btn link'
								} } only %}
							</div>

						</div>
					</div>
				</swiper-slide>
			{% endfor %}

			<div slot="container-end">
				<div class="swiper-actions">
					<div class="swiper-nav-container">
						<button type="button" class="swiper-btn-prev" aria-label="{{ 'Previous slide'|t }}">
							{{ svg("@webroot/assets/graphics/arrow-left.svg")|attr({
								class: 'swiper-btn-icon',
							}) }}
						</button>
						<button type="button" class="swiper-btn-next" aria-label="{{ 'Next slide'|t }}">
							{{ svg("@webroot/assets/graphics/arrow-right.svg")|attr({
								class: 'swiper-btn-icon',
							}) }}
						</button>
					</div>
				</div>
			</div>

		</swiper-container>

	</div>
</article>
{% endif %}
