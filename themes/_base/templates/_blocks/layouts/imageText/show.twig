{% import '_blocks/partials/background' as background %}
{% import '_utilities/format' as format %}
{% import '_utilities/transforms' as transform %}

{% set reverse = reverse ? true : false %}
{% set cycle = reverse ? ['reverse', 'standard'] : ['standard', 'reverse'] %}
{% set uid = uid ?? random() %}

<article class="image-text-show section relative {{ background.classes(entry) }}" {{ blockBookmark(entry) }}{{ inlineEditBlock(entry) }}>
	{{ background.image(entry, preloadImage ?? false) }}

	{% include '_blocks/partials/heading' %}

	<div class="image-text-show__int">
		<div class="image-text-show__items">

			{% for item in items %}
				{% set index = loop.index0 %}
				{% set blockId = 'image-text-show' ~ uid ~ '-' ~ index %}
				{# Resolved rather than read straight off the item: it can pull its
				   content from a selected entry, with anything set on the item itself
				   winning field by field. See config/stables/items.php. #}
				{% set data = itemData(item) %}
				{% set icon = data.icon ?? false %}
				{% set preheading = data.preheading ?? false %}
				{% set heading = data.heading ?? false %}
				{% set intro = data.intro ?? false %}
				{% set image = data.image ?? false %}
				{% set text = data.text ?? false %}

				<div class="image-text-show__item" {{ inlineEditItem(item) }}>

					<div id="{{blockId}}" class="image-text-show__row  image-text-show__row--{{ cycle(cycle, index) }}">

						<div class="image-text-show__image-col" data-motion="{{ {
							transition: 'clip',
							opacity: [0, 1]
						}|json_encode }}">
							{{ transform.getImage({
								'asset': image,
								'transform': 'fluid',
								'wrapperClasses': 'image-text-show__image-wrapper',
								'classes': 'image-text-show__image',
								'placeholder': false,
								'preload': index == 0 and (preloadImage ?? false)
							}) }}
						</div>

						<div class="image-text-show__info" data-motion="{{ {
							transition: 'inout',
							targetId: blockId
						}|json_encode }}">
							<div class="image-text-show__info-int">
								{% if icon %}
								<span class="block-icon image-text-show__icon" aria-hidden="true">{{ renderIcon(icon) }}</span>
								{% endif %}

								{% if preheading %}
								<p class="image-text-show__preheading faux-preheading" {{ inlineEditAttrs(item, 'preheading') }}>{{ format.basic(preheading) }}</p>
								{% endif %}

								{% if heading %}
								<h2 class="faux-h3" {{ inlineEditAttrs(item, 'heading') }}>{{ format.basic(heading) }}</h2>
								{% endif %}

								{{intro}}

								{{ text|retconAttr('ul, ol', { role: 'list' })|raw }}

								{% include '_blocks/buttons' with { entry: item, options: {layout: 'left', classes:'btn image-text-show__btn link'}  } only %}
							</div>
						</div>

					</div>
				</div>      
			{% endfor %}

		</div>
	</div>
</article>