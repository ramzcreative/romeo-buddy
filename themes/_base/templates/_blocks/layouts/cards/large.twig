{% import '_utilities/format' as format %}
{% import '_utilities/transforms' as transform %}

{% set preloadImage = preloadImage ?? false %}

<article class="card-large section relative">

	{% include '_blocks/partials/heading' %}

	<div class="card-large__int container max-w-slim">
{# No reveal on the page's first block: it's above the fold, and starting
		   hidden would hold LCP until main.js runs. #}
		<div class="card-large__items"{% if not (preloadImage ?? false) %} data-reveal-group{% endif %}>

			{% for item in items %}
				{% set index = loop.index %}

				{# Resolved rather than read straight off the item: it can pull its
				   content from a selected entry, with anything set on the item itself
				   winning field by field. See config/stables/items.php. #}
				{% set data = itemData(item) %}
				{% set heading = data.heading ?? false %}
				{% set intro = data.intro ?? false %}
				{% set image = data.image ?? false %}

				<div class="card-large__item relative">

					{{format.getLinkAria(item)}}

					<div class="card-large__info">
						<div class="card-large__info-int">
							<div>
								{% if heading %}
								<p class="card-large__heading faux-h3">{{ format.basic(heading) }}</p>
								{% endif %}

								{{intro|retconAttr('p', { class: 'card-large__intro' })|retconAttr('a', { class: 'link' })}}
							</div>


							{% include '_blocks/buttons' with { entry: item, options: {layout: 'center', classes:'btn btn--arrow btn--outline card-large__btn link'}  } only %}
						</div>
					</div>


					{% if image %}
					<div class="card-large__image-container">
						{{ transform.getImage({
							'asset': image,
							'transform': 'cardLg',
							'wrapperClasses': "card-large__image-wrapper",
							'classes': "card-large__image",
							'placeholder': true,
							'preload': index == 1 and (preloadImage ?? false)
						}) }}
					</div>
					{% endif %}

				</div>
			{% endfor %}

		</div>
	</div>
</article>