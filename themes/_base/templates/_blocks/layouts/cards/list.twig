{% import '_blocks/partials/background' as background %}
{% import '_utilities/format' as format %}
{% import '_utilities/transforms' as transform %}

{% set preloadImage = preloadImage ?? false %}

<article class="card-list section relative {{ background.classes(entry) }}" {{ blockBookmark(entry) }}{{ inlineEditBlock(entry) }}>
	{{ background.image(entry, preloadImage ?? false) }}

	{% include '_blocks/partials/heading' %}

	<div class="card-list__int layout-content max-w-slim">
{# No reveal on the page's first block: it's above the fold, and starting
		   hidden would hold LCP until main.js runs. #}
		<div class="card-list__items"{% if not (preloadImage ?? false) %} data-reveal-group{% endif %}>

			{% for item in items %}
				
				{% set index = loop.index %}

				{# Resolved rather than read straight off the item: it can pull its
				   content from a selected entry, with anything set on the item itself
				   winning field by field. See config/stables/items.php. #}
				{% set data = itemData(item) %}
				{% set icon = data.icon ?? false %}
				{% set preheading = data.preheading ?? false %}
				{% set heading = data.heading ?? false %}
				{% set subheading = data.subheading ?? false %}
				{% set intro = data.intro ?? false %}
				{% set image = data.image ?? false %}

				<div class="card-list__item relative">

					{{format.getLinkAria(item)}}

					{% if image %}
					<div class="card-list__image-container">
						{{ transform.getImage({
							'asset': image,
							'transform': 'fluid',
							'wrapperClasses': "card-list__image-wrapper",
							'classes': "card-list__image",
							'placeholder': true,
							'preload': index == 1 and (preloadImage ?? false)
						}) }}
					</div>
					{% endif %}

					<div class="card-list__info">
						<div class="card-list__info-int">

							<div>
							{% if icon %}
							<span class="block-icon card-list__icon" aria-hidden="true">{{ renderIcon(icon) }}</span>
							{% endif %}

							{% if preheading %}
							<p class="card-list__preheading faux-preheading" {{ inlineEditAttrs(item, 'preheading') }}>{{ format.basic(preheading) }}</p>
							{% endif %}

							{% if heading|default %}
							<p class="card-list__heading faux-h3" {{ inlineEditAttrs(item, 'heading') }}>{{ format.basic(heading) }}</p>
							{% endif %}

							{% if subheading %}
							<p class="card-list__subheading faux-subheading" {{ inlineEditAttrs(item, 'subheading') }}>{{ format.basic(subheading) }}</p>
							{% endif %}

							{{intro|retconAttr('p', { class: 'card-list__intro' })|retconAttr('a', { class: 'link' })}}
							</div>


							{% include '_blocks/buttons' with { entry: item, options: {layout: 'center', classes:'btn btn--arrow btn--outline card-list__btn link'}  } only %}
						</div>
					</div>
				</div>
			{% endfor %}

		</div>
	</div>
</article>