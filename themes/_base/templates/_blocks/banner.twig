{% import '_utilities/format' as format %}
{% import '_utilities/transforms' as transform %}

{# The shared `items` field — banner used to keep heading/intro/image/buttons
   on the block itself, which made it a dead end: cards, slider and imageText
   can all be switched between because they share this field, and banner
   couldn't join them. #}
{% set items = entry.items.with(itemEagerLoadPaths()).all() ?? false %}

{% if items %}
<article class="banner section">

	{% include '_blocks/partials/heading' %}

	<div class="banner__int container max-w-slim">
{# No reveal on the page's first block: it's above the fold, and starting
		   hidden would hold LCP until main.js runs. #}
		<div class="banner__items"{% if not (preloadImage ?? false) %} data-reveal-group{% endif %}>

			{% for item in items %}
				{% set data = itemData(item) %}
				{% set heading = data.heading ?? false %}
				{% set intro = data.intro ?? false %}
				{% set image = data.image ?? false %}
				{% set index = loop.index %}

				<div class="banner__item">

					{{ format.getLinkAria(item) }}

					{% if image %}
					<div class="banner__image-container">
						{{ transform.getImage({
							'asset': image,
							'transform': 'fluid',
							'wrapperClasses': "banner__image-wrapper",
							'classes': "banner__image",
							'placeholder': true,
							'preload': index == 1 and (preloadImage ?? false)
						}) }}
					</div>
					{% endif %}

					<div class="banner__info">
						<div class="banner__info-int">
							{% if heading %}
							<p class="banner__heading faux-h3">{{ format.basic(heading) }}</p>
							{% endif %}

							{{ intro|retconAttr('p', { class: 'banner__intro' })|retconAttr('a', { class: 'link' }) }}

							{% include '_blocks/buttons' with { entry: item, options: {layout: 'center', classes:'btn btn--arrow btn--outline banner__btn link'} } only %}
						</div>
					</div>

				</div>
			{% endfor %}

		</div>
	</div>
</article>
{% endif %}
