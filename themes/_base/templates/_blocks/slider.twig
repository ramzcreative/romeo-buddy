{% import '_utilities/format' as format %}
{% import '_utilities/transforms' as transform %}

{% set isLast = last ?? false %}
{% set layout = entry['layoutSliders']|default('carousels') %}
{# Primed before the loop: the layouts resolve each item through
   itemData(), and without this each one would query for its source
   entry and again for that entry's image. #}
{% set items = entry.items.with(itemEagerLoadPaths()).all() ?? false %}

{% if items %}
	{# `entry` is in the list because partials/heading — included by all four
	   slider layouts — reads `entry['blockHeading']`. With `only` in play it was
	   out of scope, so the Block Heading field would save in the CP and render
	   nothing at all. #}
	{% include "_blocks/layouts/sliders/#{layout}" with{
		entry: entry,
		items: items,
		uid: entry.uid,
		preloadImage: preloadImage ?? false
	} only %}
{% endif %}