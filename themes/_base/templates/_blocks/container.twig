{% set background = entry.backgroundRole ? 'bg--' ~ entry.backgroundRole : 'bg--none' %}
{% set isLast = last ?? false %}
{% set layout = entry['layoutText'] ?? 'center' %}
{% set parent = parent ?? 'default' %}
{% set blocks = entry['containerBlocks'] ?? null %}

{% set defaultAttr = {
	class: [
		'container-block',
		'overflow-hidden',
		'section',
		background != 'bg--none' ? background ~ ' section section--has-bg' : background,
		isLast ? 'section--last',
	]
} %}

<article {{attr(defaultAttr)}}>
	{% include '_blocks/partials/heading' %}

	{% include "_blocks/_builder" with {"parent": 'container' } %}
</article>
