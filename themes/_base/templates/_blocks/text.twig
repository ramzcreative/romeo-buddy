{% if entry %}
	{# bodyText's chunks each need their own wrapper, so they go through the
	   builder rather than rendering as one blob. #}
	{% include "_blocks/_builder" with {
		blocks: entry.bodyText,
		parent: parent ?? 'builder',
		parentIsLast: last ?? false,
		preloadClaimed: preloadClaimed ?? false,
	} only %}
{% endif %}
