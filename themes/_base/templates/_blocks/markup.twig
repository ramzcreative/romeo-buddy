{% set isLast = last ?? false %}		
{% set parent = parent ?? 'default' %}

{% set defaultAttr = {
    class: [
        'text-block',
        'section section--sm',
        'prose',
        isLast ? 'section--last',
    ],
    id: anchorId ?? null,
} %}

<article {{attr(defaultAttr)}}>
    <div class="text-block__int prose {{ parent != 'column' ? 'layout-text'}}">
        {{ chunk|retconAttr('ul, ol', { role: 'list' }) }}
    </div>
</article>