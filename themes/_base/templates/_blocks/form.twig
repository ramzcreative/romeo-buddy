{% import '_utilities/format' as format %}
{% import '_blocks/partials/background' as background %}



{% set layout = entry['layoutForms'] ?? 'contact' %}
{# Also included standalone for the sitewide footer form (_partials/footer.twig), where the owner is the 'footer'
   GlobalSet, not an Entry — partials/background checks the owner's type with `is instance of` for that reason. #}

{% set defaultAttr = {
    class: [
        'forms form-default',
        'section',
        background.classes(entry),
    ]
} %}

<article {{attr(defaultAttr)}} {{ inlineEditBlock(entry) }}>
	{{ background.image(entry, preloadImage ?? false) }}

	{% include '_blocks/partials/recaptcha' %}

	<div class="form-header-wrapper">
	{% include '_blocks/partials/formHeading' %}
	</div>

	<div class="form-form-wrapper layout-text">
		{% include "_blocks/layouts/forms/#{layout}" %}
	</div>
</article>
