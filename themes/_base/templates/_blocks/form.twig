{% import '_utilities/format' as format %}



{% set layout = entry['layoutForms'] ?? 'contact' %}
{# form.twig is also included standalone for the sitewide footer form
   (see _partials/footer.twig), where the owner is the 'footer' GlobalSet,
   not an Entry — `is instance of` guards the nested-in-Container check
   below from calling .type on an element that doesn't have one. #}
{% set owner = entry.owner %}
{% set ownerIsContainer = owner is instance of('craft\\elements\\Entry') and owner.type == 'container' %}
{% set background = ownerIsContainer ? 'bg--none' : entry['background']['color'][0]['background']|default('bg--none') %}

{% set defaultAttr = {
    class: [
        'forms form-default',
        'section',
        background != 'bg--none' ? background ~ ' section-padding' : background,
    ]
} %}

<article {{attr(defaultAttr)}}>

	{% include '_blocks/partials/recaptcha' %}

	<div class="form-header-wrapper">
	{% include '_blocks/partials/formHeading' %}
	</div>

	<div class="form-form-wrapper wrapper-text">
		{% include "_blocks/layouts/forms/#{layout}" %}
	</div>
</article>
