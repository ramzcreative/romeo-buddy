{% macro search() %}<svg class="admin-bar__i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 20 20"/></svg>{% endmacro %}

{% macro external() %}<svg class="admin-bar__i" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 15 20 4"/><path d="M14 4h6v6"/><path d="M20 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h6"/></svg>{% endmacro %}

