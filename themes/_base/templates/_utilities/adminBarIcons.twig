{% macro collapse() %}<svg class="admin-bar__i admin-bar__i--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3v6H3"/><path d="M15 3v6h6"/><path d="M21 21v-6h-6"/><path d="M3 21v-6h6"/></svg>{% endmacro %}
