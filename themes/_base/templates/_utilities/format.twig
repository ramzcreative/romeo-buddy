{# Both macros below allow a small set of inline formatting tags in
   otherwise-plain-text values (entry.title, PlainText fields like excerpt,
   etc. — none of which get HTMLPurifier's pass at save time the way
   CKEditor fields do). `striptags()` only filters tag *names*; it does not
   touch attributes on whatever tags survive, so `<a onmouseover="...">` or
   `<strong onclick="...">` passed straight through unchanged before — use
   Craft's `purify` filter (real HTMLPurifier) with an explicit allowlist
   instead, so a disallowed attribute or a `javascript:` href actually gets
   stripped, not just a disallowed tag name. #}
{% macro basic(str) %}
{% apply spaceless %}
    {% set str = str ?? '' %}

    {{ str|purify({
        'HTML.AllowedElements': ['small', 'sup', 'sub', 'strong', 'em', 'a', 'br'],
        'HTML.AllowedAttributes': ['a.href', 'a.target', 'a.rel'],
    }) }}
{% endapply %}
{% endmacro %}

{% macro simple(str) %}
{% apply spaceless %}
    {% set str = str ?? '' %}

    {{ str|purify({
        'HTML.AllowedElements': ['small', 'sup', 'sub', 'strong', 'em', 'br'],
        'HTML.AllowedAttributes': [],
    }) }}
{% endapply %}
{% endmacro %}

{% macro plain(str) %}
{% apply spaceless %}
    {% set str = str ?? '' %}

    {# No |raw. striptags() removes tag NAMES only — quotes, = and handler
       text all survive it — so bypassing Twig's escaping here let a native
       title break out of any attribute it landed in. Verified: with |raw,
       a title of  Hike" onmouseover="alert(1)" x="  rendered as a live
       event handler inside aria-label. Twig escapes with ENT_QUOTES, which
       closes it; purify() does NOT, because HTMLPurifier uses ENT_NOQUOTES
       and leaves the double quote intact.

       Consequence for callers: this macro now returns ESCAPED markup. Pass
       str|striptags directly, not this macro, when the value goes through
       |t() — the translation filter returns a plain string that Twig then
       escapes again, giving &amp;quot; in the output. #}
    {{ str|striptags }}
{% endapply %}
{% endmacro %}


{# ── LINKS ──────────────────────────────────────────────────────────────
   A link field's value or nothing. Every macro here renders NOTHING when
   there is no link, so a caller can wrap the whole element in one guard and
   never emit a bare <a href="">.

   getLinkAttr  attributes only, for a caller supplying its own tag and
                content (see collage.twig, which needs its own &nbsp;)
   getLink      a complete anchor with the link's label as its text
   getLinkAria  a bare overlay anchor for a whole-card hit area — hidden
                from AT because the real link is elsewhere in the card
   ──────────────────────────────────────────────────────────────────────── #}
{% macro getLinkAttr(link, classes) %}
{%- apply spaceless -%}
	{% if link ?? false %}
		{{ attr({
			class: classes|default(null),
			href: link.value,
			target: link.target,
			rel: link.target == '_blank' ? 'noopener noreferrer' : null,
		}) }}
	{% endif %}
{%- endapply -%}
{% endmacro %}

{% macro getLink(link, classes) %}
{% apply spaceless %}
	{% if link ?? false %}
		<a {{ _self.getLinkAttr(link, classes) }}>{{ link.label|default(craft.app.config.custom.linkDefault) }}</a>
	{% endif %}
{% endapply %}
{% endmacro %}

{% macro getLinkAria(link, classes) %}
{% apply spaceless %}
	{% if link is instance of('craft\\elements\\Entry') %}
		{# Two kinds of entry reach this. An item block carries a `buttons`
		   field and the overlay should follow it. A page, post or job has no
		   buttons and links to itself — resolving only the buttons path left
		   those cards with no link at all, for any user, which is why several
		   templates hand-rolled this anchor instead. #}
		{% set fromButtons = link.buttons.one() ?? false %}
		{% set link = fromButtons
			? (fromButtons.linkUrl ?? false)
			: (link.url ? { value: link.url, target: null } : false) %}
	{% else %}
		{% set link = link ?? false %}
	{% endif %}

	{% if link %}
		{# The &nbsp; gives the overlay something to lay out; several card
		   templates hand-rolled this same anchor for exactly that reason. #}
		<a {{ _self.getLinkAttr(link, ('ada-link ' ~ (classes|default('')))|trim) }} aria-hidden="true" tabindex="-1">&nbsp;</a>
	{% endif %}
{% endapply %}
{% endmacro %}
