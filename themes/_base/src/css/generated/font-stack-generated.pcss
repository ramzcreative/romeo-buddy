/* AUTO-GENERATED by modules/themedesigner — hand edits here will be
   overwritten the next time Font Stack is saved (or Base's own is
   re-synced to a theme following it). */

:root {
  --font-display: 'Baloo Bhaina 2', sans-serif;
  --font-body: 'ABeeZee', sans-serif;
  --font-accent: sans-serif;

  /* h1 */
  --h1-font: var(--font-display);
  --h1-fw: var(--fw-heavy);
  --h1-fs: var(--fs-3xl);
  --h1-lh: var(--lh-tight);
  --h1-ls: var(--ls-normal);

  /* h2 */
  --h2-font: var(--font-display);
  --h2-fw: var(--fw-heavy);
  --h2-fs: var(--fs-2xl);
  --h2-lh: var(--lh-tight);
  --h2-ls: var(--ls-normal);

  /* h3 */
  --h3-font: var(--font-display);
  --h3-fw: var(--fw-bold);
  --h3-fs: var(--fs-xl);
  --h3-lh: var(--lh-tight);
  --h3-ls: var(--ls-normal);

  /* h4 */
  --h4-font: var(--font-body);
  --h4-fw: var(--fw-bold);
  --h4-fs: var(--fs-lg);
  --h4-lh: var(--lh-tight);
  --h4-ls: var(--ls-normal);

  /* h5 */
  --h5-font: var(--font-body);
  --h5-fw: var(--fw-normal);
  --h5-fs: var(--fs-sm);
  --h5-lh: var(--lh-tight);
  --h5-ls: var(--ls-normal);

  /* h6 */
  --h6-font: var(--font-body);
  --h6-fw: var(--fw-normal);
  --h6-fs: var(--fs-base);
  --h6-lh: var(--lh-tight);
  --h6-ls: var(--ls-normal);

  /* subheading */
  --subheading-font: var(--font-body);
  --subheading-fw: var(--fw-bold);
  --subheading-fs: var(--fs-md);
  --subheading-lh: var(--lh-tight);
  --subheading-ls: var(--ls-wide);

  /* preheading */
  --preheading-font: var(--font-body);
  --preheading-fw: var(--fw-bold);
  --preheading-fs: var(--fs-md);
  --preheading-lh: var(--lh-tight);
  --preheading-ls: var(--ls-wide);

  /* paragraph */
  --paragraph-font: var(--font-body);
  --paragraph-fw: var(--fw-normal);
  --paragraph-fs: var(--fs-base);
  --paragraph-lh: var(--lh-normal);
  --paragraph-ls: var(--ls-normal);

  /* paragraphLg */
  --paragraph-lg-font: var(--font-body);
  --paragraph-lg-fw: var(--fw-normal);
  --paragraph-lg-fs: var(--fs-lg);
  --paragraph-lg-lh: var(--lh-loose);
  --paragraph-lg-ls: var(--ls-normal);

  /* paragraphSm */
  --paragraph-sm-font: var(--font-body);
  --paragraph-sm-fw: var(--fw-normal);
  --paragraph-sm-fs: var(--fs-sm);
  --paragraph-sm-lh: var(--lh-tight);
  --paragraph-sm-ls: var(--ls-normal);

  /* paragraphXs */
  --paragraph-xs-font: var(--font-body);
  --paragraph-xs-fw: var(--fw-normal);
  --paragraph-xs-fs: var(--fs-xs);
  --paragraph-xs-lh: var(--lh-tight);
  --paragraph-xs-ls: var(--ls-normal);

  /* link */
  --link-font: var(--font-body);
  --link-fw: var(--fw-medium);
  --link-fs: var(--fs-base);
  --link-lh: var(--lh-tight);
  --link-ls: var(--ls-normal);
}
