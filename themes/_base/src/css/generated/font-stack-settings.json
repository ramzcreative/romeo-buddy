{
    "display": "baloo-bhaina-2",
    "body": "abeezee",
    "accent": null,
    "styles": {
        "h1": {"font": "display", "weight": "heavy", "size": "3xl", "lineHeight": "tight", "letterSpacing": "normal"},
        "h2": {"font": "display", "weight": "heavy", "size": "2xl", "lineHeight": "tight", "letterSpacing": "normal"},
        "h3": {"font": "display", "weight": "bold", "size": "xl", "lineHeight": "tight", "letterSpacing": "normal"},
        "h4": {"font": "body", "weight": "bold", "size": "lg", "lineHeight": "tight", "letterSpacing": "normal"},
        "h5": {"font": "body", "weight": "normal", "size": "sm", "lineHeight": "tight", "letterSpacing": "normal"},
        "h6": {"font": "body", "weight": "normal", "size": "base", "lineHeight": "tight", "letterSpacing": "normal"},
        "subheading": {"font": "body", "weight": "bold", "size": "md", "lineHeight": "tight", "letterSpacing": "wide"},
