        "paragraphSm": {"font": "body", "weight": "normal", "size": "sm", "lineHeight": "tight", "letterSpacing": "normal"},
        "paragraphXs": {"font": "body", "weight": "normal", "size": "xs", "lineHeight": "tight", "letterSpacing": "normal"},
