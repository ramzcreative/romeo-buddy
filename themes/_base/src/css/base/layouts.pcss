/** ============================================
    SECTION — vertical rhythm

    One family. --section-space is the only knob: the size modifiers change
    nothing else, and both the margin form and the background form read it,
    so .section--lg.section--has-bg gets large PADDING for free.
============================================ **/
.section{
    --section-space: var(--section-space-md);
    margin-block: var(--section-space);
}
.section--sm{ --section-space: var(--section-space-sm); }
.section--lg{ --section-space: var(--section-space-lg); }

/* A section painting a background can't use margin — the colour would stop
   short of the space. Same token, moved inside. Must stay after .section so
   it wins the margin-block at equal specificity. */
.section--has-bg{
    margin-block: 0;
    padding-block: var(--section-space);
}

/** ============================================
    A size modifier governs the space on BOTH sides of itself

    Margins collapse to the LARGER of the two, so without this a section
    marked small still sits in default space and the modifier means nothing.
    The neighbour yields instead.
============================================ **/
.section--sm:not(.section--has-bg) + .section:not(.section--sm):not(.section--lg):not(.keep-gap):not(.keep-gap-top){
    margin-block-start: 0;
}
.section:not(.section--sm):not(.section--lg):not(.keep-gap):not(.keep-gap-bottom):has(+ .section--sm:not(.section--has-bg)){
    margin-block-end: 0;
}
.section--lg:not(.section--has-bg) + .section:not(.section--sm):not(.section--lg):not(.keep-gap):not(.keep-gap-top){
    margin-block-start: 0;
}
.section:not(.section--sm):not(.section--lg):not(.keep-gap):not(.keep-gap-bottom):has(+ .section--lg:not(.section--has-bg)){
    margin-block-end: 0;
}

/** ============================================
    Nested sections only

    A band's padding is INTERNAL — it holds the band's own content off its
    own coloured edge. A sibling section's margin is a different space, from
    that edge to its content. Two adjacent siblings are not contained in one
    another, so both spaces are legitimate and neither is collapsed away.

    Contained is the exception: a section INSIDE a band sits within padding
    that already provides its outer space, so its facing margin goes.

    Collapsing between consecutive SAME-background bands is a separate
    mechanism and lives in the generated .bg--{role} sibling rule — see
    backgrounds-generated.pcss. That is where .keep-gap / .keep-gap-top /
    .keep-gap-bottom do their work; either neighbour can keep a join open,
    since the space between two sections is one join.
============================================ **/
.section--has-bg > .section:first-child:not(.keep-gap):not(.keep-gap-top){
    margin-block-start: 0;
}
.section--has-bg > :is(.section:last-child, .section--last):not(.keep-gap):not(.keep-gap-bottom){
    margin-block-end: 0;
}

/** ============================================
    section headings
============================================ **/
.section-header{
    margin-inline: auto;
    margin-block-end: var(--spacer-5);

    &:last-child{ margin-block-end: 0;}

    /* Same gaps .prose gives a pre/subheading. */
    .section-header__preheading + *{ margin-block-start: calc(var(--spacer-1) / 2); }
    .section-header__subheading{ margin-block-start: var(--spacer-1); }

    @media (--screen-lg){
        margin-block-end: var(--spacer-6);
    }
}

/** ============================================
    containers
============================================ **/
/** ============================================
    PADDING LANES — trial (2026-09-17)
============================================ **/
/* Each lane is its own query container, as .container was: cq units inside a
   lane measure the lane's content box, not the viewport. */
.layout-content,
.layout-wide,
.layout-text,
.breakout-left-content,
.breakout-right-content {
  container-type: inline-size;
}

.layout-content {
  padding-inline: var(--layout-offset-content);
}

.layout-wide {
  padding-inline: var(--layout-offset-wide);
}

.layout-text {
  /* Padding alone caps it at --max-text and keeps the mobile gutter: with
     box-sizing: border-box, adding max-width too subtracts the padding twice
     (measured: 705px box, 288px padding a side, 129px of text). */
  padding-inline: var(--layout-offset-text);
}

/* Asymmetric Breakouts become incredibly easy with padding math */
.breakout-left-content {
  padding-left: 0;
  padding-right: var(--layout-offset-content);
}

.breakout-right-content {
  padding-left: var(--layout-offset-content);
  padding-right: 0;
}


/** ============================================
    buttons layout
============================================ **/
.button-wrapper{
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacer-2);
    margin-block-start: var(--spacer-4);

    &:first-child{
        margin-block-start: 0;
    }
}
.button-wrapper--center{
    justify-content: center;
}
.button-wrapper--right{
    justify-content: flex-end;
}

/** ============================================
    global footer/form spacing
============================================ **/
/** tweaks for footer form that slides up **/
.has-form .section--last{
    margin-block-end: calc(var(--footer-offset));
    padding-block-end: calc( var(--spacing-y) + (-1 * var(--footer-offset)) );
}