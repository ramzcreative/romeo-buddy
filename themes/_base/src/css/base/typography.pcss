.faux-h1,
.faux-h2,
.faux-h3,
.faux-h4,
.faux-h5,
.faux-h6,
.faux-preheading,
.faux-subheading,
h1,h2,h3,h4,h5,h6,p,ul,ol{ 
    text-wrap: balance;
    color: var(--text-color);

    &:first-child{ margin-block-start: 0;}

    margin-block-start: var(--spacer-1);
    margin-block-end: 0;
    
    @media (--screen-lg){
        margin-block-start: var(--spacer-3);
    }
}


/* h1 */
.faux-h1,
h1:not([class*='faux-'], .ignore) {
    font-family: var(--h1-font);
    font-weight: var(--h1-fw);
    font-size: var(--h1-fs);
    line-height: var(--h1-lh);
    letter-spacing: var(--h1-ls);
    color: var(--heading-color, var(--text-color));
}
/* h2 */
.faux-h2,
h2:not([class*='faux-'], .ignore){
    font-family: var(--h2-font);
    font-weight: var(--h2-fw);
    font-size: var(--h2-fs);
    line-height: var(--h2-lh);
    letter-spacing: var(--h2-ls);
}
/* h3 */
.faux-h3,
h3:not([class*='faux-'], .ignore){
    font-family: var(--h3-font);
    font-weight: var(--h3-fw);
    font-size: var(--h3-fs);
    line-height: var(--h3-lh);
    letter-spacing: var(--h3-ls);
}
/* h4 */
.faux-h4,
h4:not([class*='faux-'], .ignore){
    font-family: var(--h4-font);
    font-weight: var(--h4-fw);
    font-size: var(--h4-fs);
    line-height: var(--h4-lh);
    letter-spacing: var(--h4-ls);
}
/* h5 */
.faux-h5,
h5:not([class*='faux-'], .ignore){
    font-family: var(--h5-font);
    font-weight: var(--h5-fw);
    font-size: var(--h5-fs);
    line-height: var(--h5-lh);
    letter-spacing: var(--h5-ls);
}
/* h6 */
.faux-h6,
h6:not([class*='faux-'], .ignore){
    font-family: var(--h6-font);
    font-weight: var(--h6-fw);
    font-size: var(--h6-fs);
    line-height: var(--h6-lh);
    letter-spacing: var(--h6-ls);
}

/* headers */
.faux-subheading{
    font-family: var(--subheading-font);
    font-weight: var(--subheading-fw);
    font-size: var(--subheading-fs);
    line-height: var(--subheading-lh);
    letter-spacing: var(--subheading-ls);
    text-transform:uppercase;
    color: var(--subheading-color, var(--font-color-dark));
}
/* all following subheading */
.faux-subheading + *:not(.ignore) {
    margin-block-start: var(--spacer-1);

    @media (--screen-lg){
        margin-block-start: var(--spacer-2);
    }
}

.faux-preheading{
    font-family: var(--preheading-font);
    font-weight: var(--preheading-fw);
    font-size: var(--preheading-fs);
    line-height: var(--preheading-lh);
    letter-spacing: var(--preheading-ls);
    text-transform:uppercase;
    color: var(--preheading-color, var(--font-color-dark));
}
/* all following preheading */
.faux-preheading + *:not(.ignore) {
    margin-block-start: var(--spacer-1);

    @media (--screen-lg){
        margin-block-start: var(--spacer-2);
    }
}

/* p tags — ol/ul keep their own explicit font sizing here (out of Font
   Stack's 13 text styles, unrelated to the paragraph rule below). */
ol,
ul{
    font-family: var(--font-body);
    font-size: var(--fs-base);
    line-height: var(--lh-normal);
}

:is(p:not([class*='faux-']):not(.ignore), .faux-p){
    font-family: var(--paragraph-font);
    font-weight: var(--paragraph-fw);
    font-size: var(--paragraph-fs);
    line-height: var(--paragraph-lh);
    letter-spacing: var(--paragraph-ls);
}
.faux-p-lg{
    font-family: var(--paragraph-lg-font);
    font-weight: var(--paragraph-lg-fw);
    font-size: var(--paragraph-lg-fs);
    line-height: var(--paragraph-lg-lh);
    letter-spacing: var(--paragraph-lg-ls);
}
.faux-p-sm{
    font-family: var(--paragraph-sm-font);
    font-weight: var(--paragraph-sm-fw);
    font-size: var(--paragraph-sm-fs);
    line-height: var(--paragraph-sm-lh);
    letter-spacing: var(--paragraph-sm-ls);
}
.faux-p-xs{
    font-family: var(--paragraph-xs-font);
    font-weight: var(--paragraph-xs-fw);
    font-size: var(--paragraph-xs-fs);
    line-height: var(--paragraph-xs-lh);
    letter-spacing: var(--paragraph-xs-ls);
}

/* p,ul,ol */
ol:not(.ignore),
ul:not(.ignore),
:is(p:not([class*='faux-']):not(.ignore), .faux-p){
    text-wrap: balance;
}

/* before p */
* + :is(p, .faux-p):not(.ignore) {
    &:first-child{ margin-block-start: 0;}
    
    @media (--screen-lg){
        margin-block-start: var(--spacer-2);
    }
}
/* after p */
:is(p, .faux-p):not(.ignore, [class*='faux-']) + *:not(.ignore) {
    margin-block-start: var(--spacer-4);

    @media (--screen-lg){
        margin-block-start: var(--spacer-5);
    }
}




/* ==============================================
    LISTS — every value comes from generated/lists-generated.pcss
    (Theme Designer › Components › Lists); edit there, not here.
============================================== */
ol:not(.ignore),
ul:not(.ignore) {
    margin-block-start: var(--list-margin);
    font-weight: var(--list-fw);

    &:first-child{ margin-block-start: 0;}

    ul,
    ol{
        margin-block-start: var(--ul-nested-gap) !important;
        margin-bottom: var(--ul-nested-gap);
    }

    li {
        margin-block-start: var(--list-item-gap);
    }

    li:first-child{
        margin-block-start: 0;
    }
}

/* ==============================================
    UL
============================================== */
ul:not(.ignore) {

    ul{
        @media (--screen-lg){
            margin-block-start: var(--list-item-gap);
            margin-left: var(--ul-nested-indent);
        }
    }

    li {
        position: relative;
        list-style: none;
        padding-left: var(--ul-indent);

        &::before{
            content: '';
            position: absolute;
            /* Centred on the first line whatever the marker size. */
            top: calc((1lh - var(--ul-marker-size)) / 2);
            left: 0;

            width: var(--ul-marker-size);
            aspect-ratio: 1;

            background: var(--ul-marker-color);
            border-radius: var(--ul-marker-radius);
        }
    }

    li li {
        margin: var(--ul-nested-gap) 0;

        &::before {
            border: 2px solid var(--ul-l2-border-color);
            background: var(--ul-l2-bg);
        }
    }

    li li li {
        &::before {
            background: var(--ul-l3-bg);
            border-color: var(--ul-l3-border-color);
        }
    }
}

/* ==============================================
    OL
============================================== */
ol:not(.ignore){
    padding-left: var(--ol-indent);

    li {
        list-style: var(--ol-style-1);
        padding-left: var(--spacer-1);

        &::marker {
            font-weight: var(--ol-marker-fw);
        }
    }

    ol li {
        list-style: var(--ol-style-2);
    }

    ol ol li {
        list-style: var(--ol-style-3);
    }
}


/* ==============================================
    Custom checkmark list styling
============================================== */
ul.custom-checkmark {
    list-style: none; /* Remove default bullets */
    padding-left: var(--spacer-4);

    li{
        margin-block-start: var(--spacer-4);
        padding-left: var(--spacer-4);
    }
}

ul.custom-checkmark li::before {
    content: "✓";
    color: var(--text-color-light);
    font-weight: var(--fw-bold);
    display: inline-flex; 
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    aspect-ratio: 1/1;
    border-radius: var(--radius-full);
    background: var(--primary);
    border: 2px solid var(--dark);
    margin-top: -.5em;
    margin-left: -1em;
}
/* ==============================================
    LINK
============================================== */
a{
    text-decoration: none;
}
:is(h1, h2, h3, h4, h5, h6, p, ul:not(.ignore), ol:not(.ignore)) a:not(.btn):not(.ignore){
    font-family: var(--link-font);
    font-weight: var(--link-fw);
    font-size: var(--link-fs);
    line-height: var(--link-lh);
    letter-spacing: var(--link-ls);

    -ms-word-break: break-all;
    word-break: break-all;

    /* Non standard for WebKit */
    word-break: break-word;

    -webkit-hyphens: auto;
    -moz-hyphens: auto;
    hyphens: auto;	
    
    color: var(--link-color);

    transition: color var(--transition-base);

    &:focus,
    &:hover {
        color: var(--link-hover-color);
    }
}
/* ==============================================
    HR
============================================== */
hr{
    width: 100%;
    height: 2px;
    background: var(--text-color);
}

/* ==============================================
    ALERTS
============================================== */
#appcss .alert-error{
    font-size: 16px;
    color: var(--error);
}