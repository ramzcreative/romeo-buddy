/*==========================================================
    ARTICLE DETAIL
==========================================================*/
.article-takeaways,
.article-sources{
    margin-block: var(--spacer-6);
    padding: var(--spacer-5);
    border-radius: var(--radius-lg);
    background-color: color-mix(in srgb, var(--gray-light, #ccc) 35%, transparent);
}
.article-takeaways__heading,
.article-sources__heading{
    margin-block-end: var(--spacer-3);
}
.article-takeaways__items{
    display: grid;
    gap: var(--spacer-2);
}
.article-sources__items{
    display: grid;
    gap: var(--spacer-2);
    padding-inline-start: 1.5em;
    font-size: var(--paragraph-sm-fs);
    line-height: var(--paragraph-sm-lh);
    list-style: decimal;
}

/*==========================================================
    PROJECTS
==========================================================*/
.project-detail__int{
    display: grid;
    gap: var(--spacer-6);

    @media (--screen-md){
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
        align-items: start;
    }
}
.project-detail__facts{
    display: grid;
    gap: var(--spacer-3);
    margin: 0;
}
.project-detail__fact{
    dt{
        font-size: var(--paragraph-sm-fs);
        font-weight: var(--fw-bold);
        text-transform: uppercase;
        letter-spacing: .05em;
    }
    dd{
        margin: 0;
    }
}
.project-detail__gallery{
    margin-block-start: var(--spacer-7);
}

.projects-listing__items{
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: var(--spacer-5);
}
.project-card{
    position: relative;
}
.project-card__image-wrapper{
    aspect-ratio: 600 / 475;
    overflow: hidden;
    border-radius: var(--radius-lg);
}
.project-card__image{
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.project-card__body{
    display: grid;
    gap: var(--spacer-1);
    padding-block: var(--spacer-3);
}
.project-card__client{
    font-size: var(--paragraph-sm-fs);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: .05em;
}
.project-card__link{
    color: inherit;

    &::after{
        content: '';
        position: absolute;
        inset: 0;
    }
    &:hover,
    &:focus-visible{
        text-decoration: underline;
        text-underline-offset: .2em;
    }
}
.project-card:has(.project-card__link:focus-visible){
    outline: 2px solid var(--primary);
    outline-offset: 2px;
}
