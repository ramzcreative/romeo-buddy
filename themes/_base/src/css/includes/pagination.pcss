/*==========================================================
    PAGINATION

    Shared by every listing section (see _sections/_listing.twig).
    Lifted out of blog.pcss when the blog stopped being the only thing
    that paginates — the rules were already named .pagination__*, only
    the list container was blog-specific.
==========================================================*/
.pagination__items{
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;

    gap: var(--spacer-3);

    margin: 0;
    padding: 0;
}

.pagination__item{
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    color: var(--gray-light);

    transition: color var(--transition-base);

    &:hover,
    &:focus:not(:focus-visible){
        color: var(--primary);
    }
}

.pagination__item--current{
    color: var(--primary);
    text-decoration: underline;
}
