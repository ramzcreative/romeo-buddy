.footer{
    position: sticky;
    top: 100%;
}
.footer__logo-link{
    display: block;
    width: 100%;
    max-width: 150px;
    margin-bottom: var(--spacer-5);
}

.footer-top__int{
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    @media (--screen-lg){
        flex-direction: row;
        gap: var(--spacer-7);
    }
}

.footer__phone{
    margin-top: var(--spacer-2);
}

#appcss .footer__copyright{
    padding: var(--spacer-2) 0;
    color: var(--text-color-light);
}

/*==========================================================
    NAV
==========================================================*/
.footer__nav{
    display: flex;
    flex-direction: column;
    gap: var(--spacer-2);

    .menu__link{
        font-size: var(--fs-base);
        color: var(--text-color-light);

        transition: color var(--transition-base);

        @media (--screen-lg){
            white-space: nowrap;
        }

        &:hover,
        &:focus{
            color: var(--primary);
        }
    }
}
.footer__nav-heading{
    font-size: var(--h4-fs);
    font-weight: var(--fw-bold);
}

.footer__column--grid{
	display: flex;
	gap: var(--spacer-6);
}


/*==========================================================
    SOCIAL NAV
==========================================================*/
.footer-social__items{
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacer-3);
    margin-top: var(--spacer-5);

    @media (--screen-md){
        gap: var(--spacer-5);
        margin-top: var(--spacer-6);
    }
}
.social__link{
    display: block;
    width: auto;
    height: 24px;
    color: var(--text-color-light);

    transition: color var(--transition-base);

    @media (--screen-md){
        height: 32px;
    }

    svg{
        width: auto;
        height: 100%;
    }

    &:hover,
    &:focus{
        color: var(--primary);
    }
}



/** sitewide theme preview banner — logged-in users only, see
    _partials/themePreview.twig **/
.theme-preview-banner{
    position: fixed;
    z-index: 30;
    top: var(--header-height);
    left: 0;

    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--spacer-3);

    width: 100%;
    padding: var(--spacer-2) var(--spacer-4);

    background: #ed2250;
    color: white;
    font-size: 14px;
    font-weight: var(--fw-medium);
    text-align: center;
    box-shadow: 0px 1px 15px rgb(0 0 0 / 15%);
}

.theme-preview-banner__actions{
    display: flex;
    gap: var(--spacer-2);
    flex-shrink: 0;
}

.theme-preview-banner__btn{
    display: inline-block;
    padding: var(--spacer-1) var(--spacer-3);
    border: 1px solid white;
    border-radius: 4px;
    background: transparent;
    color: white;
    font-size: 13px;
    font-weight: var(--fw-medium);
    line-height: 1.15;
    text-decoration: none;
    cursor: pointer;

    transition: background .3s;

    &:hover,
    &:focus{
        background: rgb(255 255 255 / 15%);
    }
}

.theme-preview-banner__btn--primary{
    background: white;
    color: #ed2250;

    &:hover,
    &:focus{
        background: rgb(255 255 255 / 85%);
    }
}