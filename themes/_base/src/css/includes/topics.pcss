/*==========================================================
    TOPIC PAGE
==========================================================*/
.topic-header__int{
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacer-3);
}
.topic-header__parent{
    font-size: var(--paragraph-sm-fs);
    text-transform: uppercase;
    letter-spacing: .05em;

    a{
        color: inherit;
        text-decoration: underline;
        text-underline-offset: .2em;
    }
}
.topic-header__children{
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacer-2);
    margin-block-start: var(--spacer-2);
}
.topic-header__child{
    display: inline-block;
    padding: var(--spacer-1) var(--spacer-3);
    border: 1px solid currentColor;
    border-radius: 999px;
    color: var(--text-color);

    &:hover,
    &:focus-visible{
        color: var(--primary);
    }
}

.topic-entries__heading{
    margin-block-end: var(--spacer-5);
}
.topic-entries__filter{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacer-3);
    margin-block-end: var(--spacer-5);
}
.topic-entries__items{
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--spacer-4);

    @media (--screen-lg){
        gap: var(--spacer-5);
    }
}
.topic-entries__footer{
    margin-block-start: var(--spacer-6);
}
