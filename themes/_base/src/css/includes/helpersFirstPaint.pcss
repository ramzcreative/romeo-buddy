/* Helpers the first frame needs, moved from helpers.pcss: the skip link otherwise takes space until
   main.css lands and then shifts the page. */

/* First focusable element on every page (see _layouts/scaffold.twig) —
   off-screen until keyboard-focused, then jumps on top of the header
   (same z-index tier as header.pcss's own 9999) so it's never obscured. */
.skip-link {
	position: absolute;
	top: -100%;
	left: 0;
	z-index: var(--z-sticky);

	padding: 0.75rem 1.25rem;
	background: var(--primary);
	color: var(--text-color-light);
	font-weight: 600;
	text-decoration: none;

	transition: top .15s;
}

.skip-link:focus-visible {
	top: 0;
	box-shadow: var(--ring-shadow);
	outline: none;
}
