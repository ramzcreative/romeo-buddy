
/** ============================================
	helpers
============================================ **/
.shrink-0{
	flex-shrink: 0;
}
.px-0{
	padding-left: 0;
	padding-right: 0;
}
.py-0{
	padding-top: 0;
	padding-bottom: 0;
}
.pt-0{
	padding-top: 0;
}
.pb-0{
	padding-bottom: 0;
}
.mx-0{
	margin-left: 0;
	margin-right: 0;
}
.my-0{
	margin-top: 0;
	margin-bottom: 0;
}
.mt-0{
	margin-top: 0;
}
.mb-0{
	margin-bottom: 0;
}
.max-w-none{
	max-width: none;
}
.max-w-content{
	max-width: var(--content);
}
.max-w-wide{
	max-width: var(--wide);
}
.max-w-text{
	max-width: var(--text);
}
.overflow-hidden{
	overflow: hidden;
}
/* Clips like hidden without becoming a scroll container, so position: sticky inside still pins. */
.overflow-clip{
	overflow: clip;
}
.absolute{
	position: absolute;
}
.relative{
	position: relative;
}
.object-fit{
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.uppercase{
	text-transform: uppercase;
}
.case{
	text-transform: none;
}
.text-center{
	text-align: center;
}

.visually-hidden {
	position: absolute;
	overflow: hidden;
	height: 1px;
	width: 1px;

	clip: rect(1px, 1px, 1px, 1px);
	-webkit-clip-path: inset(0px 0px 99.9% 99.9%);
	clip-path: inset(0px 0px 99.9% 99.9%);

	padding: 0;
	border: 0;

}

/* .skip-link loads from helpersFirstPaint.pcss (critical). */

.break-word {
	-ms-word-break: break-all;
	word-break: break-all;

	/* Non standard for WebKit */
	word-break: break-word;

	-webkit-hyphens: auto;
	-moz-hyphens: auto;
	hyphens: auto;
}

.rounded{
	overflow:hidden;
	border-radius: var(--radius);
}
.border{
	border: solid 2px var(--secondary);
}

.overlay{
	background-image: linear-gradient(
		in oklch to top, 
		rgb(0 0 0 / 75%),
		rgb(0 0 0 / 0%));
}

.full-width-break{
	width: 100vw;
	margin-inline: calc(50% - 50vw);
}

.stack{
	display: flex;
	flex-direction: column;
	gap: var(--stack-gap, var(--spacer-3));
}

/* Flow spacing, opt-in. One margin per gap — never a top/bottom pair — so it
   behaves the same in normal flow, flex and grid. */
.prose > * + *{
	margin-block-start: var(--prose-gap, var(--spacer-4));
}
.prose > :is(h1, h2, h3, h4, h5, h6,
             .faux-h1, .faux-h2, .faux-h3, .faux-h4, .faux-h5, .faux-h6){
	--prose-gap: var(--spacer-6);
}
.prose > :is(h1, h2, h3, h4, h5, h6,
             .faux-h1, .faux-h2, .faux-h3, .faux-h4, .faux-h5, .faux-h6) + *{
	--prose-gap: var(--spacer-2);
}
/* A pre/subheading labels what follows, so it sits tight to it. */
.prose > .faux-preheading + *{
	--prose-gap: calc(var(--spacer-1) / 2);
}
.prose > .faux-subheading + *{
	--prose-gap: var(--spacer-1);
}

/* .pile loads from helpersFirstPaint.pcss (critical). */

.dev{
	border: 2px solid red;
}

/** ============================================
    links
============================================ **/
.ada-link{
    position: absolute;
    display: block;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    cursor: pointer;
}

#appcss .link{
    position: relative;
    z-index: 4;
}