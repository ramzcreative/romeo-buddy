/*==========================================================
    NAV
==========================================================*/
.blog-nav{

}
.blog-nav__int{
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--spacer-4);
    text-align: center;

    @media (--screen-md){
        flex-direction: row;
        gap: var(--spacer-5);
    }
}
.blog-nav__label{
    flex-shrink: 0;
    font-weight: var(--fw-heavy);
    color: var(--primary);
    font-size: var(--fs-md);
    line-height: var(--lh-tight);

    @media (--screen-md){
        font-size: var(--fs-lg);
    }
}
.blog-nav__items{
    display: inline-grid;
    grid-auto-flow: column;
    gap: var(--spacer-3);
    padding: 2px 0 var(--spacer-2);

    @media (--screen-md){
        gap: var(--spacer-5);
    }

    .menu__link{
        position: relative;
        font-size: var(--fs-base);
        line-height: var(--lh-tight);
        font-weight: var(--fw-medium);
        color: var(--text-color);
        white-space: nowrap;
        flex-shrink: 0;

        @media (--screen-md){
            font-size: var(--fs-md);
        }

        &::after{
            content: '';
            position: absolute;
            bottom: 2px;
            left: 50%;
            transform: translateX(-50%);
            width: 10%;
            height: 2px;
            background: currentColor;
            opacity: 0;

            transition: all var(--transition-base);
        }
        
        &.is-active-link::after,
        &:focus:not(:focus-visible)::after,
        &:hover::after{
            opacity: 1;
            width: 100%;
        }
    }
}
/*==========================================================
    POSTS
==========================================================*/
.blog-posts__items{
    /* Columns from lg up. Change this one value to go three across to four. */
    --blog-columns: 3;

    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacer-5);

    @media (--screen-sm){
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (--screen-lg){
        grid-template-columns: repeat(var(--blog-columns), minmax(0, 1fr));
    }
}

/*----------------------------------------------------------
    CARD

    The jobs listing's treatment: a filled, rounded card that
    lifts as one hit area. A post leads with an image where a
    vacancy has none, so the image sits on top and the body
    below it carries the jobs card's flex rhythm.
----------------------------------------------------------*/
.blog-posts__item{
    --blog-card-bg: var(--body-medium);

    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: var(--blog-card-bg);

    transition: transform var(--transition-base) var(--ease-default),
                box-shadow var(--transition-base) var(--ease-default);

    /* The whole card is a hit area (.ada-link in the template), so it lifts
       as one. focus-within matters because the real link sits inside it. */
    &:hover,
    &:focus-within{
        transform: translateY(-3px);
        box-shadow: var(--shadow);
    }

    &:hover .blog-posts__item-image,
    &:focus-within .blog-posts__item-image{
        opacity: .75;
    }

    @media (prefers-reduced-motion: reduce){
        transition: none;

        &:hover,
        &:focus-within{
            transform: none;
        }
    }
}

.blog-posts__item-int{
    display: flex;
    flex-direction: column;
    height: 100%;
}

.blog-posts__item-image-wrapper{
    display: block;
    flex: none;
    aspect-ratio: 3 / 2;

    overflow: hidden;
    background: var(--gray-dark);
}
.blog-posts__item-image{
    width: 100%;
    height: 100%;
    object-fit: cover;

    transition: opacity var(--transition-base) var(--ease-default);
}

.blog-posts__item-info{
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    /* One gap rather than per-element margins, so a post with no excerpt
       still spaces evenly. */
    gap: var(--spacer-3);

    padding: var(--spacer-5);

    @media (--screen-md){
        padding: var(--spacer-6);
    }
}

#appcss .blog-posts__item-title{
    margin: 0;
    font-size: var(--h4-fs);
    text-wrap: balance;
}

.blog-posts__item-intro-wrapper{
    font-size: var(--paragraph-sm-fs);
    line-height: var(--paragraph-sm-lh);
}

.blog-posts__item-button-wrapper{
    /* Pins the CTA to the bottom so buttons line up across a row of uneven
       cards. */
    margin-block-start: auto;
    padding-block-start: var(--spacer-3);
}

/*----------------------------------------------------------
    FEATURED LEAD POST

    index.twig's useFeatured, off by default. Spans the row and
    takes a wider image; otherwise the standard card.
----------------------------------------------------------*/
.blog-posts__item--wide{
    grid-column: 1 / -1;
}

.blog-posts__item--wide .blog-posts__item-image-wrapper{
    @media (--screen-sm){
        aspect-ratio: 213/112;
    }
}

#appcss .blog-posts__item--wide .blog-posts__item-title{
    font-size: var(--subheading-fs);
    text-transform: unset;

    @media (--screen-md){
        font-size: var(--h3-fs);
    }
}

/*==========================================================
    PAGINATION — controls themselves live in includes/pagination.pcss
==========================================================*/
.blog-posts__footer{
    margin-block-start: var(--spacer-7);

    @media (--screen-md){
        margin-block-start: var(--spacer-9);
    }
}

.blog-posts__none{
    padding-block: var(--spacer-8);
}

/*==========================================================
    DETAIL
==========================================================*/

/* block overrides */
.blog-detail{
    .container-text{
        max-width: 100%;
    }
}

/*----------------------------------------------------------
    DETAIL HERO

    The jobs detail's band, in blog's own colour: back link,
    title and date on a filled band, with the post image
    straddling its lower edge.
----------------------------------------------------------*/
.blog-detail__hero{
    padding-block: var(--spacer-7);
    color: var(--on-primary-dark);
    background-color: var(--primary-dark);

    /* Any heading dropped in here inherits the band's colour. The h1 itself
       carries `.ignore` in the markup, which is the stronger fix — see below —
       but this keeps a second heading from arriving dark-on-dark later. */
    --heading-color: var(--on-primary-dark);
}

/* Extra room below so the image can sit up into the band. */
.blog-detail__hero--with-media{
    padding-block-end: var(--spacer-9);
}

.blog-detail__hero-int{
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacer-4);
}

/* Light because it sits on the band. */
.blog-detail__back{
    --btn-plain-text: var(--on-primary-dark);
    --btn-plain-text-hover: var(--on-primary-dark);

    margin-block-end: var(--spacer-2);
    opacity: .85;

    &:hover,
    &:focus-visible{
        opacity: 1;
    }
}

.blog-detail__heading{
    margin: 0;
    /* Needs `.ignore` on the h1 in the markup to take effect at all.
       base/typography.pcss styles `h1:not([class*="faux-"], .ignore)` at
       specificity (0,1,1), which beats this rule's (0,1,0) — so without the
       opt-out the title would keep --h1-fs and the global heading colour,
       rendering dark on the dark band. */
    font-family: var(--h3-font);
    font-size: var(--h3-fs);
    font-weight: var(--h3-fw);
    line-height: var(--h3-lh);
    letter-spacing: var(--h3-ls);
    color: inherit;
    text-wrap: balance;
}

.blog-detail__date{
    margin: 0;
    font-size: var(--paragraph-sm-fs);
    line-height: var(--paragraph-sm-lh);
    color: inherit;
    opacity: .85;
}

.blog-detail__hero-media{
    position: relative;
    z-index: var(--z-raised);
    /* Pulls up into the band so the image straddles its lower edge. */
    margin-block-start: calc(var(--spacer-8) * -1);
}

.blog-detail__hero-image-wrapper{
    display: block;
    border-radius: var(--radius-lg);
}
.blog-detail__hero-image{
    display: block;
    width: 100%;
    min-height: 275px;

    @media (--screen-md){
        min-height: 400px;
    }
}

/* columns */
.blog-detail__row{
    display: flex;
    flex-direction: column;
    gap: var(--spacer-5);

    @media (--screen-md){
        flex-direction: row;
        gap: var(--spacer-7);
    }
}
.blog-detail__column--main{
    .container{
        padding-left: 0;
        padding-right: 0;

        @media (--screen-md){
            margin-top: var(--spacer-7);
            margin-bottom: var(--spacer-7);
        }

        &:last-child{
            margin-bottom: 0;
        }
    }
    .section-header{
        @media (--screen-md){
            margin-bottom: var(--spacer-7);
        }
    }
    
}

.blog-detail__column{
    flex-grow: 1;
}

#appcss .blog-detail__heading{
    font-size: var(--subheading-fs);
    font-weight: var(--fw-bold);
    line-height: 1.25;
    text-transform: unset;

    @media (--screen-md){
        font-size: var(--h3-fs);
    }
}
.blog-detail__intro{
    margin-top: var(--spacer-3);
}

/** side column **/
.blog-detail__column--side{
    width: 100%;
    
    @media (--screen-md){
        max-width: 210px;
    }
    @media (--screen-lg){
        max-width: 240px;
    }
}

/* cat */
.blog-detail__cats{
    @media (--screen-md){
        padding-top: var(--spacer-4);
        padding-bottom: var(--spacer-4);
        padding-left: var(--spacer-6);
        border-left: 3px solid var(--gray);
    }
}
#appcss .blog-detail__cats-heading{
    font-weight: var(--fw-heavy);
    color: var(--primary);

    margin-bottom: var(--spacer-5);
}
.blog-detail__cats-items{
    display: flex;
    flex-direction: column;
    gap: var(--spacer-3);
}
.blog-detail__cats-item{
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    line-height: var(--lh-tight);
    color: var(--text-color);

    transition: color var(--transition-base);

    &:hover,
    &:focus{
        color: var(--primary);
    }

    @media (--screen-md){
        font-size: var(--fs-lg);
    }
}

/*==========================================================
    FILTERS

    Only rendered when index.twig's useFilters is on — it's the
    alternative to blog-nav, not an addition to it. Either way the posts
    block's Show Filters field can hide it.
==========================================================*/
.blog-filters{
    padding-block: var(--spacer-5);
}

.blog-filters__set{
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--spacer-4);

    border: 0;
    margin: 0;
    padding: 0;
}

.blog-filters__field{
    display: flex;
    flex-direction: column;
    gap: var(--spacer-1);

    label{
        font-size: var(--paragraph-sm-fs);
        font-weight: var(--fw-semibold);
        text-transform: uppercase;
        letter-spacing: var(--ls-loose);
    }
}

.blog-filters__select,
.blog-filters__input{
    padding: var(--spacer-2) var(--spacer-3);
    border: 1px solid var(--body-medium);
    border-radius: var(--radius, 4px);
    font: inherit;
    min-width: 12rem;
}

.blog-filters__actions{
    display: flex;
    align-items: center;
    gap: var(--spacer-3);
}
