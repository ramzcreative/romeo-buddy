/*==========================================================
    GALLERY
==========================================================*/
.gallery{
    --gallery-columns: 3;
    --gallery-gap: var(--spacer-3);
    --gallery-radius: var(--radius);
    --gallery-lightbox-backdrop: rgb(0 0 0 / 90%);

    display: block;
}
.gallery__items{
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gallery-gap);

    @media (--screen-md){
        grid-template-columns: repeat(var(--gallery-columns), minmax(0, 1fr));
    }
}
.gallery__item,
.gallery__figure{
    margin: 0;
}
.gallery__link{
    display: block;
    overflow: hidden;
    border-radius: var(--gallery-radius);

    &:focus-visible{
        outline: 2px solid var(--primary);
        outline-offset: 2px;
    }
}
.gallery__image-wrapper{
    display: block;
}
.gallery__image{
    display: block;
    width: 100%;
    height: auto;
    transition: transform var(--transition-base) var(--ease-out);

    .gallery__link:hover &{
        transform: scale(1.03);
    }
}
.gallery--grid .gallery__image{
    aspect-ratio: 4 / 3;
    object-fit: cover;
}
.gallery__caption{
    margin-block-start: var(--spacer-2);
    font-size: var(--paragraph-sm-fs);
    line-height: var(--paragraph-sm-lh);
}

/* Masonry: columns keep each image's own shape. */
.gallery--masonry .gallery__items{
    display: block;
    columns: 2;
    column-gap: var(--gallery-gap);

    @media (--screen-md){
        columns: var(--gallery-columns);
    }
}
.gallery--masonry .gallery__item{
    break-inside: avoid;
    margin-block-end: var(--gallery-gap);
}

/* Ticker: one height, 4:3 crops, in a <ticker-row>. */
.gallery--ticker{
    --gallery-ticker-height: 240px;
    --ticker-gap: var(--gallery-gap);
}
.gallery--ticker .gallery__image{
    width: auto;
    height: var(--gallery-ticker-height);
    aspect-ratio: 4 / 3;
    object-fit: cover;
}
.gallery--ticker .gallery__caption{
    max-width: calc(var(--gallery-ticker-height) * 4 / 3);
}

/*----------------------------------------------------------
    LIGHTBOX
----------------------------------------------------------*/
.gallery-lightbox{
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: var(--spacer-7) var(--spacer-4);
    border: 0;
    color: #fff;
    background: transparent;

    &::backdrop{
        background: var(--gallery-lightbox-backdrop);
    }

    &[open]{
        display: grid;
        grid-template-rows: 1fr auto;
        align-items: center;
        justify-items: center;
        gap: var(--spacer-3);
    }
}
.gallery-lightbox__figure{
    display: grid;
    justify-items: center;
    gap: var(--spacer-2);
    min-height: 0;
    max-height: 100%;
    margin: 0;
}
.gallery-lightbox__image{
    max-width: min(100%, 1600px);
    max-height: calc(100dvh - 12rem);
    object-fit: contain;
    touch-action: pan-y;
}
.gallery-lightbox__caption,
.gallery-lightbox__count{
    color: inherit;
    font-size: var(--paragraph-sm-fs);
    text-align: center;
}
.gallery-lightbox__btn{
    position: absolute;
    padding: var(--spacer-2) var(--spacer-3);
    border: 1px solid rgb(255 255 255 / 50%);
    border-radius: var(--radius);
    color: #fff;
    background: rgb(0 0 0 / 60%);
    font: inherit;
    cursor: pointer;

    &:hover{
        background: rgb(0 0 0 / 85%);
    }
    &:focus-visible{
        outline: 2px solid #fff;
        outline-offset: 2px;
    }
}
.gallery-lightbox__btn--close{
    top: var(--spacer-3);
    right: var(--spacer-3);
}
.gallery-lightbox__btn--prev,
.gallery-lightbox__btn--next{
    bottom: var(--spacer-4);
}
.gallery-lightbox__btn--prev{
    left: var(--spacer-3);
}
.gallery-lightbox__btn--next{
    right: var(--spacer-3);
}

@media (prefers-reduced-motion: no-preference){
    .gallery-lightbox[open]{
        animation: gallery-lightbox-in 250ms var(--ease-out);
    }
}
@keyframes gallery-lightbox-in{
    from{
        opacity: 0;
        transform: scale(.97);
    }
}
@media (prefers-reduced-motion: reduce){
    .gallery__image{
        transition: none;
    }
}
