.spotlight{
    --gap: var(--spacer-3);
}

/* One column — each item is already a full-width image/text pair, so the grid
   is here for the gap between them rather than for columns. */
.spotlight__items{
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap);
}

/* The positioning context for its own image, which goes absolute at lg. Was
   .spotlight__int before the block moved onto the shared `items` field — with
   more than one item that has to be per-item, or every image would anchor to
   the same box. */
.spotlight__item{
    position: relative;
    z-index: var(--z-raised);

    display: flex;
    flex-direction: column;
}

.spotlight__image-container{
    position: relative;
    z-index: var(--z-behind);
    
    width: 100%;

    @media (--screen-lg){
       position: absolute;
	   left: 0;
	   top: 0;
	   height: 100%;
    }
}
.spotlight__image-wrapper{
    display: block;
    width: 100%;
	overflow: hidden;

    @media (--screen-lg){
        position: absolute;
        top: 0;
        left: 50%;
		transform: translateX(-50%);
        height: 100%;
		width: calc( var(--spacing-x) + 100%);
    }
}
.spotlight__image{
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.spotlight__info{
    display: flex;
    justify-content: flex-end;
    width: 100%;
	flex-shrink: 0;

    @media (--screen-lg){
        width: clamp(500px, 40vw, 675px);
        padding: var(--spacing-y) 0;
    }
}
.spotlight__info-int{
    display: flex;
    align-items: center;
    width: 100%;
    padding: var(--spacing-x);

    @media (--screen-lg){
        min-height: 400px;
        padding: clamp(50px, 3.5vw, 75px);
    }
}
