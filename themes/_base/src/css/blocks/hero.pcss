/*==========================================================
    STANDARD HERO
==========================================================*/
.hero-standard{
    z-index: var(--z-raised);
	margin-top: calc(var(--header-height) * -1);
}
.hero-standard__int{
    height: 1px;
    min-height: 250px;
    
    @media (--screen-md){
        min-height: clamp(400px, 30vmin, 100vh);
    }
}
.hero-standard__image-wrapper{
    display: block;
    position: absolute;
    z-index: var(--z-behind);
    left: 0;
    top: 0;

    width: 100%;
    height: 100%;

    &::before{
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: var(--gray-dark);
        opacity: .45;
    }
}
.hero-standard__media{
    position: absolute;
    z-index: var(--z-behind);
    inset: 0;
}
.hero-standard__image{
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.hero-standard__info{
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 100%;
}
.hero-standard__info-int{
    width: 100%;
    max-width: 500px;
}
.hero-standard__btn{
    margin-top: var(--spacer-3);

    @media (--screen-lg){
        margin-top: var(--spacer-5);
    }
}

/* Video: the player covers the hero at 16:9 whatever its shape, behind the copy, under the same overlay as the image. */
.hero-standard__video{
    position: absolute;
    inset: 0;
    pointer-events: none;
}
.hero-standard__video-player{
    position: absolute;
    z-index: var(--z-behind);
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: size;
    pointer-events: none;

    & > *{
        position: absolute;
        top: 50%;
        left: 50%;
        width: max(100cqw, 177.78cqh);
        height: max(100cqh, 56.25cqw);
        transform: translate(-50%, -50%);
    }

    & .hero-standard__image-wrapper::before{
        content: none;
    }

    &::after{
        content: '';
        position: absolute;
        inset: 0;
        background: var(--gray-dark);
        opacity: .45;
    }
}
.hero-standard__video > .video-player__toggle{
    pointer-events: auto;
    top: auto;
    bottom: var(--spacer-3);
}

/*==========================================================
    PRODUCT HERO
==========================================================*/
.hero-product__int{
    display: grid;
    align-items: center;
    gap: var(--spacer-5);

    @media (--screen-lg){
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--spacer-8);
    }
}
.hero-product__image-col{
    border-radius: var(--radius);
    overflow: hidden;
}
.hero-product__image-wrapper{
    display: block;
}
.hero-product__image{
    width: 100%;
    height: auto;
}
.hero-product__btn{
    margin-top: var(--spacer-3);

    @media (--screen-lg){
        margin-top: var(--spacer-5);
    }
}
