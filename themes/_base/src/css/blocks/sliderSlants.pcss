/**
    Slant slider

    Angled panels; the active one expands out from underneath the panel to its
    left. Positioning, width and z-index are all written by
    js/SliderEffects/effect-slant.esm.js — this file owns only the shape and
    the chrome.

    The slant is a clip-path parallelogram, deliberately NOT skew(). A skewed
    panel needs a counter-skewed image, the two cancel about different origins,
    and the residual drifts as the panel width animates — which opens a
    triangular gap in a top corner at narrow viewports and is why the usual
    version of this effect breaks at arbitrary breakpoints. A box always covers
    its own clip path, so there is nothing here that can come apart.

    --slant-offset is set on the container by the effect, from the real
    measured height, so the shape and the layout can never disagree.
*/

.slider-slants{
    --slant-offset: 0px;
    --slant-height: clamp(380px, 56vh, 640px);
    --slant-radius: 0px;

    overflow: hidden;

    &__int{
        position: relative;
    }

    /* Height goes on the HOST element, not on Swiper's own .swiper-slant class.
       Swiper Element applies its generated classNames inside its shadow root,
       so `.swiper-slant` is unreachable from page CSS — targeting it leaves the
       container at height 0, which in turn leaves swiper.width undefined and
       the effect with nothing to lay out. (The previous version of this file
       targeted .swiper-material and never matched for exactly this reason.)

       The effect positions every panel absolutely, so there is no in-flow
       content left to give the container a height of its own. */
    &__container{
        display: block;
        height: var(--slant-height);
        overflow: visible;
    }

    /* Stays in normal flow so Swiper can measure it — that measurement is what
       produces each slide's `progress`, which every value below derives from.
       It is `static` so the panel inside positions against the container
       instead of against the slide, which Swiper would otherwise move too. */
    &__slide{
        position: static;
        /* Pure ruler. The slide is never seen — the panel inside is absolutely
           positioned and clipped — but Swiper measures these to build its snap
           grid and to derive each slide's progress. At full width there is
           exactly one snap step per slide, so next/prev advance progress by
           exactly 1. Narrower slides leave Swiper almost no travel (four at 26%
           only exceed the container by 4%), and next/prev then move a fraction
           of a step and stall. Panel geometry comes from the effect params, not
           from here. */
        width: 100%;
        height: 100%;
    }

    /* The visible parallelogram. The box is --slant-offset wider than this
       shape; panels advance by the visible width, so adjacent slanted edges
       interlock with no seam between them. */
    /* width, transform and z-index all come from the effect. */
    &__panel{
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        transition-property: transform, width;
        transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform, width;
        overflow: hidden;
        border-radius: var(--slant-radius);
        clip-path: polygon(
            var(--slant-offset) 0,
            100% 0,
            calc(100% - var(--slant-offset)) 100%,
            0 100%
        );
        background-color: var(--gray-light);
    }

    /* Counter-moved by the effect while its panel opens. No counter-skew, so
       the image is never distorted and never needs to be oversized. */
    &__media{
        position: absolute;
        inset: 0;
        transition-property: transform;
        transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;

        img,
        picture{
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    }

    &__info{
        position: absolute;
        z-index: var(--z-raised);
        inset-inline: 0;
        bottom: 0;

        display: flex;
        flex-direction: column;
        gap: var(--spacer-2);

        padding: var(--spacer-6) var(--spacer-5) var(--spacer-5);
        /* Keeps text clear of the leading slanted edge. */
        padding-inline-start: calc(var(--spacer-5) + var(--slant-offset));

        color: var(--text-color-light);
        background: linear-gradient(to top, rgb(0 0 0 / 72%), transparent);

        /* Only the active panel is wide enough to read; the collapsed ones
           would just show clipped words. */
        opacity: 0;
        transition: opacity .35s ease;

        .swiper-slide-active &{
            opacity: 1;
        }
    }

    &__heading{
        color: inherit;
        text-wrap: balance;
    }

    &__intro{
        color: inherit;
        max-width: 48ch;
    }

    /* Navigation sits outside the panels so it never lands on a slanted edge. */
    .swiper-actions{
        position: absolute;
        z-index: var(--z-raised);
        right: var(--spacer-4);
        bottom: var(--spacer-4);

        display: flex;
        gap: var(--spacer-2);
    }

    @media (prefers-reduced-motion: reduce){
        &__slide,
        &__media,
        &__info{
            transition-duration: 1ms !important;
        }
    }
}
