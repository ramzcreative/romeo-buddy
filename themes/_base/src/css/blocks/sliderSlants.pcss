/**
    Slant slider

    The Material effect with an angled edge. All the motion — the panel widening
    as it becomes active, the image easing behind it — is Material's own
    (includes/sliderMaterial.pcss + js/SliderEffects/effect-material.esm.js).
    This file adds the slant and the copy treatment, and nothing else.

    The slant is a clip-path parallelogram on .swiper-material-wrapper, NOT a
    skew. A skewed panel needs a counter-skewed image; the two cancel about
    different origins, so they only agree at one panel width and the residual
    drifts as the width animates — which opens a triangular gap in a top corner
    at narrow viewports, and is why the same approach breaks at arbitrary
    breakpoints. A box always covers its own clip path.

    Everything is scoped under .slider-slants, so layouts/sliders/hero.twig —
    the same Material effect, unslanted — is unaffected.
*/

.slider-slants{
    /* Derived from the panel height rather than a viewport unit, so the angle
       holds at every breakpoint instead of shearing. */
    --slant-angle: 10deg;
    --slant-height: clamp(380px, 56vh, 620px);
    --slant-offset: calc(var(--slant-height) * tan(var(--slant-angle)));

    --swiper-material-slide-border-radius: 0;

    position: relative;

    &__int{
        position: relative;
        height: var(--slant-height);
        /* The slanted edges overhang the panel box; let them bleed. */
        margin-inline: calc(var(--slant-offset) * -0.5);
    }

    &__container{
        display: block;
        height: var(--slant-height);
    }

    /* The visible parallelogram. Material sizes and positions this element —
       the clip path only reshapes it, so the two never fight. */
    .swiper-material-wrapper{
        clip-path: polygon(
            var(--slant-offset) 0,
            100% 0,
            calc(100% - var(--slant-offset)) 100%,
            0 100%
        );
    }

    /* Material sizes and positions this; nothing here fights it. The vendor
       .swiper-material-wrapper above is already a fixed-size window with
       overflow:hidden, so it is the thing that crops — no second clip needed. */
    &__content{
        background-color: var(--gray-light);
    }

    /* The fix for the squish.
       Left to itself the image fills the content box, so as Material narrows
       that box the photo compresses horizontally and then vanishes — a
       neighbour reads as being crushed rather than covered. Pinning the media
       to a constant width and centring it means the box clips it instead: the
       image holds its proportions and the active panel simply overlaps it,
       from either direction, which is the Apple-TV read. */
    /* The fix for the squish.
       Material narrows .swiper-material-content to reveal a slide, and an image
       filling that box compresses with it — a neighbour reads as crushed rather
       than covered. Holding the media at the full slide width and letting the
       vendor wrapper crop it means the photo keeps its proportions and the
       active panel simply overlaps it, from either direction. */
    &__media{
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: var(--slant-media-width, 100%);
        min-width: 100%;
        transform: translateX(-50%);

        img,
        picture{
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    }

    &__info{
        position: absolute;
        z-index: var(--z-raised);
        inset-inline: 0;
        bottom: 0;

        display: flex;
        flex-direction: column;
        gap: var(--spacer-2);

        padding: var(--spacer-6) var(--spacer-5) var(--spacer-5);
        /* Keeps the copy clear of the leading slanted edge. */
        padding-inline-start: calc(var(--spacer-5) + var(--slant-offset));

        color: var(--text-color-light);
        background: linear-gradient(to top, rgb(0 0 0 / 72%), transparent);
    }

    &__heading,
    &__preheading{
        color: inherit;
        text-wrap: balance;
    }

    &__intro{
        color: inherit;
        max-width: 46ch;
    }

    .swiper-actions{
        position: absolute;
        z-index: var(--z-raised);
        right: var(--spacer-4);
        bottom: var(--spacer-4);

        display: flex;
        gap: var(--spacer-2);
    }
}
