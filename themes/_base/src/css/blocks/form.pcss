/*==========================================================
    SUBSCRIBE LAYOUT
==========================================================*/

.form-header-wrapper{
	margin-bottom: var(--spacer-5);
}

/* Same gaps .prose gives a pre/subheading. */
.form-header__preheading + *{ margin-block-start: calc(var(--spacer-1) / 2); }
.form-header__subheading{ margin-block-start: var(--spacer-1); }

.form--subscribe{
	.form__actions{
		text-align: center;
	}

	@media (--screen-xs){
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: var(--spacer-2);

		.form__field{
			flex: 1 1 240px;
		}

		.form__actions{
			flex-shrink: 0;
			margin-top: 0;
		}

		.form__message{
			flex-basis: 100%;
		}
	}
}
