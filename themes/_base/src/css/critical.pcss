/* Also imported by main.pcss — see the comment there. */
@import 'base/screens.pcss';

@import 'base/normalize.pcss';
@import 'generated/scale-generated.pcss';
@import 'base/themes.pcss';
@import 'generated/fonts-generated.pcss';
@import 'includes/animateCritical.pcss';
/*@import "includes.pcss";*/
@import "includes/media.pcss";
@import 'includes/lenis.pcss';

@import 'includes/header.pcss';

/* Type belongs in the critical bundle, not main. scaffold.twig inlines this
   file into every response but loads main.css with
   `media="print" onload="this.media='all'"` — deliberately non-render-blocking.
   With typography in main, first paint had no type system at all: headings came
   up at UA sizes with UA margins and snapped to the real scale when main
   landed. The tokens it reads were already here (scale-generated, themes,
   fonts-generated, and the theme's own font-stack-generated), so this reunites
   the rules with the custom properties they consume.
   Imported LAST so the order against header.pcss is unchanged from when it
   lived at the top of main.pcss. */
@import 'base/typography.pcss';


html {
    /*scroll-behavior: smooth;*/
    height: 100%;
    width: 100%;
}
body{
    font-family: var(--font-body);
    color: var(--text-color);
    background-color: var(--body);

    .menu-active & {
        height: 100vh;
        overflow: hidden !important; 
    }
}
#app{
    min-height: 100vh;
}

.main-content-header{
    position: relative;
    z-index: 0;
}

*,
::before,
::after {
    -webkit-font-smoothing: antialiased;
}