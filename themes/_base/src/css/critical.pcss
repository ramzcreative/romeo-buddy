/* Also imported by main.pcss — see the comment there. */
@import 'base/screens.pcss';

@import 'base/normalize.pcss' layer(reset);
@import 'generated/scale-generated.pcss' layer(tokens);
@import 'generated/surfaces-generated.pcss' layer(tokens);
@import 'generated/lists-generated.pcss' layer(tokens);
@import 'base/themes.pcss' layer(tokens);
/* @font-face comes from each theme's own generated/fonts-generated.pcss: only the families it uses. */
@import 'includes/motion.pcss' layer(components);
/*@import "includes.pcss";*/
@import "includes/media.pcss" layer(components);
@import 'includes/lenis.pcss' layer(components);

@import 'includes/header.pcss' layer(components);

/* Type belongs in the critical bundle, not main. scaffold.twig inlines this
   file into every response but loads main.css with
   `media="print" onload="this.media='all'"` — deliberately non-render-blocking.
   With typography in main, first paint had no type system at all: headings came
   up at UA sizes with UA margins and snapped to the real scale when main
   landed. The tokens it reads were already here (scale-generated, themes,
   and the theme's own fonts-generated and font-stack-generated), so this reunites
   the rules with the custom properties they consume.
   Imported LAST so the order against header.pcss is unchanged from when it
   lived at the top of main.pcss. */
@import 'base/typography.pcss' layer(base);

/* Buttons and section layout, for the same first-paint reason. Moved from main.pcss in the order they had
   there; any new @import goes above the plain rules below, or postcss-import drops it. */
@import "includes/buttons.pcss" layer(components);
@import 'generated/buttons-generated.pcss' layer(theme);
@import 'base/layouts.pcss' layer(base);
@import 'includes/modalFirstPaint.pcss' layer(components);
@import 'includes/helpersFirstPaint.pcss' layer(utilities);
/* Utilities and stamps too: the page-heading and hero preheadings use both, and centred text snapping
   from start-aligned on main.css is a layout shift. */
@import 'includes/helpers.pcss' layer(utilities);
@import 'includes/stamp.pcss' layer(components);


html {
    /*scroll-behavior: smooth;*/
    height: 100%;
    width: 100%;
}
body{
    font-family: var(--font-body);
    color: var(--text-color);
    background-color: var(--body);

    .menu-active & {
        height: 100vh;
        overflow: hidden !important; 
    }
}
#app{
    min-height: 100vh;
}

.main-content-header{
    position: relative;
    z-index: 0;
}

*,
::before,
::after {
    -webkit-font-smoothing: antialiased;
}

/* .wave (helpers.pcss) and .card--grid-icons .card__icon (blocks/cards.pcss)
   moved here for the same reason typography did above: both sit directly
   under the hero, so with only normalize's `:where(svg){width:100%}` in
   effect pre-main-CSS, they had no positioning/height (.wave) or no width
   cap (.card__icon) — the divider SVG rendered as a full-viewport-width
   unpositioned bar, and each card icon rendered near the width of its card,
   both flashing large until main.css swapped in. */
.wave {
  position: absolute;
  left: 0;
  width: 100%;
  line-height: 0;
  z-index: 2;
  pointer-events: none;
}
.wave--top { top: -1px; }
.wave--bottom { bottom: -1px; transform: scaleY(-1); }
.wave svg {
	display: block;
	width: 100%;
	height: clamp(50px, 8vw, 110px);
	fill: var(--wave-color, var(--body));
}
.is-last .wave--bottom {
	display: none;
}
.card--grid-icons .card__icon{
    width: 52px;
}