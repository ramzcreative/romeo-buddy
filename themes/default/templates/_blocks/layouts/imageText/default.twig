{% import '_blocks/partials/background' as background %}
{% import '_utilities/format' as format %}
{% import '_utilities/transforms' as transform %}

{% set hasBackground = background.role(entry)|trim is not empty %}
{% set circleImages = entry['circleImages']|default(false) %}

{% set count = items|length %}
{% set reverse = reverse ? true : false %}
{% set cycle = reverse ? ['reverse', 'standard'] : ['standard', 'reverse'] %}
{% set precolors = count <= 1 ? ['stamp--sky','stamp--jungle', 'stamp--sun'] : ['stamp--jungle', 'stamp--sun', 'stamp--sky'] %}

{# id: through the service, not the raw field — it slugifies what an editor typed and keeps it unique. #}
{% set defaultAttr = {
    class: [
        'image-text-default relative section',
        background.classes(entry),
        hasBackground ? false : 'bg--none',
		circleImages ? 'image-text-default--circles' : '',
		isLast|default ? 'is-last' : false,
    ],
	id: blockBookmarkId(entry)
} %}

<article {{attr(defaultAttr)}} {{ inlineEditBlock(entry) }}>
	{{ background.image(entry, preloadImage ?? false) }}

	{% if hasBackground %}
	<div class="wave wave--top">
      <svg viewBox="0 0 1440 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,60 C240,10 480,90 720,50 C960,10 1200,90 1440,40 L1440,0 L0,0 Z" fill="var(--color-tan)"/>
      </svg>
    </div>
	{% endif %}

	{% include '_blocks/partials/heading' %}

	<div class="image-text-default__int layout-content">
{# No reveal on the page's first block: it's above the fold, and starting
		   hidden would hold LCP until main.js runs. #}
		<div class="image-text-default__items"{% if not (preloadImage ?? false) %} data-reveal-group{% endif %}>

			{% for item in items %}
				{% set index = loop.index0 %}
				{# Resolved rather than read straight off the item: it can pull its
				   content from a selected entry, with anything set on the item itself
				   winning field by field. See config/stables/items.php. #}
				{% set data = itemData(item) %}
				{% set icon = data.icon ?? false %}
				{% set heading = data.heading ?? false %}
				{% set preheading = data.preheading ?? false %}
				{% set intro = data.intro ?? false %}
				{% set image = data.image ?? false %}
				{% set text = data.text ?? false %}

				<div class="image-text-default__item">

					<div class="image-text-default__row  image-text-default__row--{{ cycle(cycle, index) }}">

						<div class="image-text-default__image-col">
							{{ transform.getImage({
								'asset': image,
								'transform': 'fluid',
								'wrapperClasses': 'image-text-default__image-wrapper',
								'classes': 'image-text-default__image',
								'placeholder': false,
								'preload': index == 0 and (preloadImage ?? false)
							}) }}
						</div>

						<div class="image-text-default__info prose">
							{% if icon %}
							<span class="block-icon image-text-default__icon" aria-hidden="true">{{ renderIcon(icon) }}</span>
							{% endif %}

							{% if preheading %}
								<p class="stamp {{ cycle(precolors, index) }} image-text-default__preheading" {{ inlineEditAttrs(item, 'preheading') }}>{{ format.basic(preheading)}}</p>
							{% endif %}

							{% if heading %}
							<h2 class="faux-h3" {{ inlineEditAttrs(item, 'heading') }}>{{ format.basic(heading) }}</h2>
							{% endif %}

							{{intro}}

							{% include "_blocks/_builder" with { blocks: text, parent: 'text' } %}

							{% include '_blocks/buttons' with { entry: item, options: {layout: 'left', classes:'btn image-text-default__btn link'}  } only %}
						</div>

					</div>
				</div>      
			{% endfor %}

		</div>
	</div>

	{% if hasBackground %}
	<div class="wave wave--bottom">
      <svg viewBox="0 0 1440 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,60 C240,10 480,90 720,50 C960,10 1200,90 1440,40 L1440,0 L0,0 Z" fill="var(--color-tan)"/>
      </svg>
    </div>
	{% endif %}
</article>