{% import '_utilities/nav' as nav %}

{# Not wrapped in {% cache %} — the active/hasActiveChild highlighting
   nav.menu() computes depends on the current request's URL, so caching
   this output would freeze whichever page's active-state happened to
   populate the cache first onto every other page's nav too. #}
{% set mainLinks = navTree('header') %}

<header class="header" data-header-container>
    <div class="header__int">
    
        <a href="{{siteUrl}}" class="header-logo">
            <span class="header-logo__pile{{ globalHeroOverlay|default(false) ? ' pile' }}">
                {% if globalHeroOverlay|default(false) %}
                    {# Both marks render, stacked via the shared .pile
                       utility (helpers.pcss) instead of hand-rolled
                       absolute positioning. header.pcss crossfades
                       between them using the SAME .has--hero-overlay
                       .header-top selector that also drives the
                       header's own background — stays in sync at
                       every scroll position, see logoLightSvg's own
                       comment in _layouts/index.twig. A wrapper span
                       (not .header-logo itself, unlike stables) since
                       this header also has "Romeo & Buddy" text
                       alongside the mark — .pile's grid would otherwise
                       drop that text onto its own row instead of
                       staying inline. #}
                    <span class="header-logo__mark header-logo__mark--standard">{{logoSvg}}</span>
                    <span class="header-logo__mark header-logo__mark--light">{{logoLightSvg}}</span>
                {% else %}
                    {{logoSvg}}
                {% endif %}
            </span>
            Romeo & Buddy
        </a>

        <button class="menu-btn menu-btn--nav" aria-label="Toggle main navigation" aria-expanded="false" aria-controls="main-nav" data-toggle-modal="main-nav" type="button">
            <div class="menu-btn__int">
                <div class="menu-btn__open">
                    <span class="menu__bar menu__bar--1"></span>
                    <span class="menu__bar menu__bar--2"></span>
                    <span class="menu__bar menu__bar--3"></span>
                </div>
                <div class="menu-btn__close">
                    <span class="menu__bar menu__bar--4"></span>
                    <span class="menu__bar menu__bar--5"></span>
                </div>
            </div>
        </button>

    </div>
</header>


<cta-modal id="main-nav" class="modal-nav" data-lenis-prevent>
    <div slot="modal">
        <a href="{{siteUrl}}" class="header-logo header-logo--menu">
            {{logoSvg}}
            Romeo & Buddy
        </a>
        <nav aria-label="Primary">
            <ul role="list" class="primary-nav ignore">
                {{ nav.menu(mainLinks)}}
            </ul>
        </nav>
    </div>
</cta-modal>