/** ============================================
	VIDEO
============================================ **/
.video__item {
	display: block;
	width: 100%;
}
.video__trigger {
	appearance: none;
	border: 0;
	margin: 0;
	padding: 0;
	width: 100%;
	background: transparent;
	cursor: pointer;
	text-align: inherit;
}

/* Plays inline in place of the thumbnail — see Components/videoPlayer.ts. */
.video-player {
	width: 100%;
	aspect-ratio: 16/9;
	background: black;

	&[hidden] {
		display: none;
	}
}
.video__image-wrapper{
    width: 100%;

	aspect-ratio: 16/9;

	@media (--screen-lg){
		aspect-ratio: 16/9;
	}
}
.video__image {
	width: 100%;
	height: 100%;
	object-fit: cover;
}
.video__btn-wrapper{
	position: absolute;
    z-index: var(--z-raised);
	top: 50%;
	left: 50%;

	transform: translate(-50%, -50%) scale(.5);

    width: 112px;
    height: 112px;
    border-radius: var(--radius-full);
    background: var(--primary);

    @media (--screen-sm){
        transform: translate(-50%, -50%) scale(.75);
    }
    @media (--screen-lg){
        transform: translate(-50%, -50%) scale(1);
    }
}
.play-btn__icon{
    width: 46px;
    height: 54px;

    background: var(--text-color-light);
    mask-repeat: no-repeat;
	mask-size: 100%;
	mask-position: center;
	mask-image: url('/assets/graphics/play.svg');
}

.video-player__toggle {
	appearance: none;
	border: 0;
	cursor: pointer;

	position: absolute;
	z-index: var(--z-raised);
	top: var(--spacer-3);
	right: var(--spacer-3);

	display: flex;
	align-items: center;
	justify-content: center;

	width: 40px;
	height: 40px;
	border-radius: var(--radius-full);
	background: rgb(0 0 0 / 50%);

	transition: background-color var(--transition-fast);

	&:hover,
	&:focus-visible {
		background: rgb(0 0 0 / 75%);
	}
}
.video-player__toggle-icon {
	width: 14px;
	height: 16px;

	background: var(--text-color-light);
	mask-repeat: no-repeat;
	mask-size: 100%;
	mask-position: center;

	[data-state='playing'] & {
		mask-image: url('/assets/graphics/pause.svg');
	}
	[data-state='paused'] & {
		width: 16px;
		mask-image: url('/assets/graphics/play.svg');
	}
}

/* Modal layout: the player mounts in this dialog on open (Components/videoPlayer.ts). Same shell as the gallery lightbox. */
.video-modal{
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: var(--spacer-7) var(--spacer-4);
    border: 0;
    background: transparent;

    &::backdrop{
        background: rgb(0 0 0 / 90%);
    }

    &[open]{
        display: grid;
        place-items: center;
    }
}
.video-modal__player{
    width: min(100%, 1400px, calc((100dvh - 12rem) * 16 / 9));
}
.video-modal__close{
    position: absolute;
    top: var(--spacer-3);
    right: var(--spacer-3);
    padding: var(--spacer-2) var(--spacer-3);
    border: 1px solid rgb(255 255 255 / 50%);
    border-radius: var(--radius);
    color: #fff;
    background: rgb(0 0 0 / 60%);
    font: inherit;
    cursor: pointer;

    &:hover{
        background: rgb(0 0 0 / 85%);
    }
    &:focus-visible{
        outline: 2px solid #fff;
        outline-offset: 2px;
    }
}
@media (prefers-reduced-motion: no-preference){
    .video-modal[open]{
        animation: video-modal-in 250ms var(--ease-out);
    }
}
@keyframes video-modal-in{
    from{
        opacity: 0;
        transform: scale(.97);
    }
}

.blur-mobile{
		position: relative;

		&::before{
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			z-index: var(--z-behind);
			width: 100%;
			height: 100%;
			background: var(--overlay-video);
			filter: blur(2px);

			opacity: .7;
		}
	@media (--screen-lg){
		&::before{
			content: none;
		}
	}
}