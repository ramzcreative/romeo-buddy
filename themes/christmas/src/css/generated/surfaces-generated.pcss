/* AUTO-GENERATED by modules/themedesigner (Surfaces tab) — hand edits
   here are overwritten on the next save. Imported from critical.pcss
   in the tokens layer; themes.pcss reads these, it no longer sets them. */
:root {
    /* corner radius */
    --radius-sm: 10px;
    --radius-md: 20px;
    --radius-lg: 32px;
    --radius-full: 50%;
    --radius: var(--radius-md);
    --form-input-border-radius: 6px;

    /* shadows */
    --shadow-sm: 0 0 5px rgba(0,0,0,0.1);
    --shadow: 0 8px 18px rgba(99,99,99,0.1), 0 6px 6px rgba(99,99,99,0.1);
    --shadow-lg: 0 8px 18px rgba(0,0,0,0.12), 0 5px 5px rgba(0,0,0,0.1);

    /* overlays — each slot wears a gradient from Colors › Gradients; a
       slot whose gradient the theme doesn't define renders nothing */
    --overlay-flat: var(--gradient-overlayflat, none);
    --overlay-bottom: var(--gradient-overlaybottom, none);
    --overlay-top: var(--gradient-overlaytop, none);
    --overlay-hero: var(--gradient-overlayhero, none);
    --overlay-hero-side: var(--gradient-overlayheroside, none);
    --overlay-carousel: var(--gradient-overlaycarousel, none);
    --overlay-carousel-copy: var(--gradient-overlaycarouselcopy, none);
    --overlay-slide-top: var(--gradient-overlayslidetop, none);
    --overlay-video: var(--gradient-overlayvideo, none);
}
