/* AUTO-GENERATED by modules/themedesigner (Lists tab) — hand edits here
   are overwritten on the next save. Imported from critical.pcss in the
   tokens layer; typography.pcss's list rules read these tokens. */
:root {
    /* every list */
    --list-margin: var(--spacer-4);
    --list-fw: var(--fw-medium);
    --list-item-gap: 2px;

    /* bullets — the marker is centred on the first line by typography.pcss */
    --ul-indent: var(--spacer-3);
    --ul-marker-size: 8px;
    --ul-marker-radius: var(--radius-full);
    --ul-marker-color: var(--primary);

    /* nested bullets */
    --ul-nested-indent: var(--spacer-2);
    --ul-nested-gap: var(--spacer-2);
    --ul-l2-bg: transparent;
    --ul-l2-border-color: var(--gray);
    --ul-l3-bg: var(--primary);
    --ul-l3-border-color: transparent;

    /* numbered */
    --ol-indent: var(--spacer-3);
    --ol-marker-fw: var(--fw-bold);
    --ol-style-1: decimal;
    --ol-style-2: lower-alpha;
    --ol-style-3: lower-roman;

    @media (--screen-lg) {
        --list-margin: var(--spacer-5);
        --ul-indent: var(--spacer-4);
        --ul-marker-size: 12px;
        --ul-nested-gap: var(--spacer-1);
    }
}
