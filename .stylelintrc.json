{
    "extends": "stylelint-config-recommended",
    "ignoreFiles": [
        "**/src/css/generated/**",
        "web/**",
        "vendor/**",
        "node_modules/**"
    ],
    "rules": {
        "at-rule-no-unknown": [
            true,
            {
                "ignoreAtRules": [
                    "custom-media",
                    "custom-selector",
                    "each",
                    "layer"
                ]
            }
        ],
        "import-notation": null,
        "no-descending-specificity": null,
        "property-no-deprecated": [
            true,
            {
                "ignoreProperties": [
                    "clip"
                ]
            }
        ]
    }
}
