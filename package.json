{
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js && npm run svg-build && npm run favicon-build && npm run logo-build",
    "preview": "vite preview --config vite.config.js",
    "typecheck": "tsc --noEmit",
    "svg-build": "svgo -f themes/_base/src/icons -o web/dist/assets/icons -r --config svgo.config.js",
    "favicon-build": "node scripts/build-favicons.mjs",
    "logo-build": "node scripts/build-logos.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"themes/**/src/css/**/*.{pcss,css}\""
  },
  "dependencies": {
    "@fancyapps/ui": "^5.0.30",
    "@fontsource/abeezee": "^5.2.8",
    "@fontsource/baloo-bhaina-2": "^5.2.8",
    "lazysizes": "^5.3.2",
    "lenis": "^1.3.14",
    "motion": "^12.23.24",
    "motion-plus": "npm:@motionplus/core@^2.12.0",
    "plyr": "^3.8.4",
    "postcss-advanced-variables": "^4.0.0",
    "svgo": "^3.0.2",
    "swiper": "^14.0.5",
    "uuid": "^13.0.0",
    "vite": "^6.4.3",
    "vite-plugin-compression2": "^2.5.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.13",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.6",
    "postcss-custom-media": "^9.1.2",
    "postcss-custom-selectors": "^7.1.2",
    "postcss-each": "^1.1.0",
    "postcss-hover-media-feature": "^1.0.2",
    "postcss-import": "^15.1.0",
    "postcss-nested": "^6.0.1",
    "postcss-pxtorem": "^6.0.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.7",
    "sharp": "^0.35.3",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "terser": "^5.37.0",
    "typescript": "^7.0.2",
    "vite-plugin-manifest-sri": "^0.2.0"
  },
  "browserslist": [
    "defaults"
  ],
  "engines": {
    "node": ">=22"
  }
}
